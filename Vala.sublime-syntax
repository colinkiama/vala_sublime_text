name: Vala
scope: source.vala

file_extensions:
  - vala
  # VAPI bindings are Vala source (declarations only, same grammar)
  - vapi

first_line_match: |-
  (?x:
    ^ \#! .* \b(vala)\b                  # shebang
  | ^ \s* // .*? -\*- .*? \bvala\b .*? -\*-  # editorconfig
  )

variables:

  bin_op: '(?:\+|->|-|\*|/|%|\|\||&&|\||&|\^|<<|>>|=>|<=|<|>=|>|==|!=|\?\?)'
  unary_op: '(?:\+\+|--|-|~|!|&|\*)'

  # numbers
  dec_exponent: '(?i)(?:[eE][-+]?(\d+))'
  float_suffix: '[fFdD]'
  integer_suffix: '(?i)(?:ULL|UL|U|LL|L)'

  # characters
  unicode_char: '(?:\\u\h{4}|\\U\h{8})'
  # Escape sequences accepted by Vala.Scanner (valascanner.vala, read_token /
  # read_template_token): \' \" \\ \0 \b \f \n \r \t \v \$
  # plus \uXXXX (exactly four hex digits) and \xHH (one or two hex digits).
  escaped_char: '\\(?:u\h{4}|x\h{1,2}|[0bfnrtv''"$\\])'

  visibility: \b(?:public|private|protected|internal)\b
  ownership: \b(?:unowned|owned|weak)\b
  base_type: (?:(?:bool|char|uchar|short|ushort|unichar|double|float|int|int8|int16|int32|int64|uint|uint8|uint16|uint32|uint64|long|ulong|size_t|ssize_t|object|string|void)\b)
  # `\?(?!\?)`: valascanner lexes `??` as the null-coalescing operator, so a
  # type never ends in `??` (`o as Foo<T>??d`, issue #15)
  type_suffix: (?:\s*(?:\[,*\]|\*|\?(?!\?))*)
  generic_declaration: \s*(<[^(={};]*>)?\s*

  brackets_capture: '((\[)(,*)(\]))'
  array_length_capture: '((\[)(\d+)(:)({{base_type}}|{{name}})(\]))'
  type_suffix_capture: '(\?(?!\?))?{{brackets_capture}}?(?:\s*(\*))?'

  # Keywords from Vala.Scanner (valascanner.vala)
  reserved: '(?:abstract|as|async|base|break|case|catch|class|const|construct|continue|default|delegate|delete|do|dynamic|else|ensures|enum|errordomain|extern|false|finally|for|foreach|get|if|in|inline|interface|internal|is|lock|namespace|new|null|out|override|owned|params|partial|private|protected|public|ref|requires|return|sealed|set|signal|sizeof|static|struct|switch|this|throw|throws|true|try|typeof|unowned|unlock|using|var|virtual|void|volatile|weak|while|with|yield)'
  name: '(?:@{{reserved}}|@{{base_type}}|@var|@?{{name_normal}})'
  # PascalCase identifiers (Vala types/namespaces), not variables like my_async
  type_name: '(?:@{{reserved}}|@{{base_type}}|@?\p{Lu}(?:{{other_char}})*)'
  # Errordomain types (IOError, DemoError, ErrorType1, …) — name contains "Error"
  errordomain_type_name: '(?:@?\p{Lu}(?:{{other_char}})*Error(?:{{other_char}})*)'
  namespaced_name: (?:(?:{{name}}{{generic_declaration}}\s*\.\s*)*{{name}}{{generic_declaration}})
  # At least Namespace.Type (not variable.member like my_async.say)
  namespaced_type_name: (?:(?:{{type_name}}{{generic_declaration}}\s*\.\s*)+{{type_name}}{{generic_declaration}})
  # ALL_CAPS members (Math.PI, Status.OK) — not PascalCase types (Gtk.Button)
  constant_member: '(?:[A-Z][A-Z0-9_]*|[A-Z])\b'
  # At least Namespace.Type.CONSTANT (n segments: n−1 type names, one constant member)
  namespaced_constant_path_lookahead: (?=(?:{{type_name}}\s*\.\s*)+{{constant_member}}\b(?!\s*\())
  identifier: \b[[:alpha:]_](?:[[:alnum:]_])*\b


  start_char: '(?:{{unicode_char}}|[_\p{L}])'
  other_char: '(?:{{unicode_char}}|[_0-9\p{L}])'
  name_normal: '{{start_char}}{{other_char}}*\b'
  cap_name: '(\p{Lu}{{other_char}})'

contexts:
  prototype:
    - include: comments
    - include: merge-conflict-markers

    # comments
  comments:
    - include: line_comments
    - include: doc_comments
    - include: block_comments

  preprocessor:
    # Not `^\s*(#)`: contexts that pop with a `(?=\S)` lookahead leave the
    # position on the '#' itself, several columns in, where `^` can never match
    # (that silently broke every indented `#endif`). The lookbehind instead
    # requires only that nothing but whitespace precedes the '#'.
    - match: '(?<![^\s])(#)\s*\b(if)\b'
      captures:
        1: punctuation.definition.preprocessor.vala
        2: keyword.control.preprocessor.if.vala
      push: preprocessor_expression_line
    - match: '(?<![^\s])(#)\s*\b(elif)\b'
      captures:
        1: punctuation.definition.preprocessor.vala
        2: keyword.control.preprocessor.elif.vala
      push: preprocessor_expression_line
    - match: '(?<![^\s])(#)\s*\b(else)\b'
      captures:
        1: punctuation.definition.preprocessor.vala
        2: keyword.control.preprocessor.else.vala
    - match: '(?<![^\s])(#)\s*\b(endif)\b'
      captures:
        1: punctuation.definition.preprocessor.vala
        2: keyword.control.preprocessor.endif.vala

  preprocessor_expression_line:
    - meta_include_prototype: false
    - meta_scope: meta.preprocessor.vala
    - include: line_comments
    - match: $\n?
      pop: true
    - match: '\|\|'
      scope: keyword.operator.preprocessor.vala
    - match: '&&'
      scope: keyword.operator.preprocessor.vala
    - match: '==|!='
      scope: keyword.operator.preprocessor.vala
    - match: '!'
      scope: keyword.operator.preprocessor.negation.vala
    - match: '[()]'
      scope: punctuation.section.preprocessor.vala
    - match: '\b(true|false)\b'
      scope: constant.language.preprocessor.vala
    - match: '\b(POSIX|GOBJECT)\b'
      scope: constant.language.preprocessor.builtin.vala
    - match: '\bVALA_\d+_\d+\b'
      scope: constant.language.preprocessor.builtin.vala
    - match: '(?!{{reserved}}\b){{identifier}}'
      scope: constant.other.preprocessor.symbol.vala
    - match: '\s+'

  line_comments:
    - match: //
      scope: punctuation.definition.comment.vala
      push:
        - meta_scope: comment.line.vala
        - match: $\n?
          pop: true

  block_comments:
    - match: /[*]
      scope: punctuation.definition.comment.begin.vala
      push:
        - meta_scope: comment.block.vala
        - match: '[*]/'
          scope: punctuation.definition.comment.end.vala
          pop: true
        - include: merge-conflict-markers

  merge-conflict-markers:
    # see also: Diff.sublime-syntax#conflict-markers
    - match: ^(<{7})(?:\s+(\S.*?))?$\n?
      scope: meta.block.conflict.begin.diff
      captures:
        1: punctuation.section.block.begin.diff
        2: entity.name.section.diff
    - match: ^(>{7})(?:\s+(\S.*?))?$\n?
      scope: meta.block.conflict.end.diff
      captures:
        1: punctuation.section.block.end.diff
        2: entity.name.section.diff
    - match: ^(\|{7}|={7})(?:\s+(\S.*?))?$\n?
      scope: meta.block.conflict.separator.diff
      captures:
        1: punctuation.section.block.diff
        2: entity.name.section.diff

  doc_comments:
    - match: /\*\*
      scope: comment.block.documentation.vala punctuation.definition.comment.begin.vala
      push: documentation

  documentation:
    - meta_include_prototype: false
    - meta_content_scope: comment.block.documentation.vala
    - include: merge-conflict-markers
    - match: '[*]/'
      scope: comment.block.documentation.vala punctuation.definition.comment.end.vala
      pop: true
    - include: documentation_block_markup
    - include: documentation_inline_markup

  documentation_inline_markup:
    # Force a newline.
    - match: <<BR>>
      scope: constant.character.escape.vala
    - include: documentation_bold_text
    - include: documentation_italic_text
    - include: documentation_underline_text
    - include: documentation_blockquote_text
    - include: documentation_link
    - include: documentation_image
    - include: documentation_link_taglet
    - include: documentation_inheritdoc_taglet

  documentation_block_markup:
    - include: documentation_code_block
    - include: documentation_list_block
    - include: documentation_table_block
    - include: documentation_headline_block
    - include: documentation_deprecated_taglet
    - include: documentation_see_taglet
    - include: documentation_param_taglet
    - include: documentation_since_taglet
    - include: documentation_return_taglet
    - include: documentation_throws_taglet

  documentation_list_block:
    - match: ^\s+(?:\*)[ ]{2,}((\d*\.|#|i\.|I\.|a\.|A\.)|(\*))\s+
      captures:
        2: markup.list.numbered.vala
        3: markup.list.unnumbered.vala

  documentation_code_block:
    - match: ^\s+(?:\*)[ ]+({{{)
      captures:
        1: punctuation.section.braces.begin.vala
      push:
        - meta_content_scope: markup.raw.block.vala
        - match: '}}}'
          scope: punctuation.section.braces.end.vala
          pop: true

  documentation_table_block:
    - match: ^\s+(?:\*)[ ]+([|]{2})\s+
      captures:
        1: punctuation.separator.vala
      push:
        - include: documentation_inline_markup
        - match: '[||]'
          scope: punctuation.separator.vala
        - match: $\n?
          pop: true

  documentation_headline_block:
    - match: ^\s+(?:\*)[ ]+(={1,4})\s+
      captures:
        1: punctuation.definition.heading.vala
      push:
        - meta_content_scope: markup.heading.vala
        - match: (={1,4})\s+
          captures:
            1: punctuation.definition.heading.vala
          pop: true

  documentation_bold_text:
    - match: "''"
      scope: punctuation.definition.bold.begin.vala
      push:
        - meta_scope: markup.bold.vala
        - match: "''"
          scope: punctuation.definition.bold.end.vala
          pop: true
        - include: documentation_inline_markup

  documentation_italic_text:
    # Force an immediate non-WS character to avoid mismatching
    # with single-line comments.
    - match: //(?!\s)
      scope: punctuation.definition.italic.begin.vala
      push:
        - meta_scope: markup.italic.vala
        - match: //
          scope: punctuation.definition.italic.end.vala
          pop: true
        - include: documentation_inline_markup

  documentation_underline_text:
    - match: __
      scope: punctuation.definition.underline.begin.vala
      push:
        - meta_scope: markup.underline.vala
        - match: __
          scope: punctuation.definition.underline.end.vala
          pop: true
        - include: documentation_inline_markup

  documentation_blockquote_text:
    - match: '``'
      scope: punctuation.definition.blockquote.begin.vala
      push:
        - meta_scope: markup.quote.vala
        - match: '``'
          scope: punctuation.definition.blockquote.end.vala
          pop: true
        - include: documentation_inline_markup

  documentation_link:
    - match: \[\[
      scope: punctuation.section.brackets.begin.vala
      push:
        - match: \|
          scope: punctuation.separator.vala
        - match: \]\]
          scope: punctuation.section.brackets.end.vala
          pop: true

  documentation_image:
    - match: \{\{
      scope: punctuation.section.brackets.begin.vala
      push:
        - match: \|
          scope: punctuation.separator.vala
        - match: \}\}
          scope: punctuation.section.brackets.end.vala
          pop: true

  documentation_link_taglet:
    - match: ({)(@link)\s+({{identifier}})(})
      captures:
        1: punctuation.section.braces.begin.vala
        2: storage.type.vala
        3: entity.name.section.vala
        4: punctuation.section.braces.end.vala

  documentation_inheritdoc_taglet:
    - match: ({)(@inheritDoc)(})
      captures:
        1: punctuation.section.braces.begin.vala
        2: storage.type.vala
        3: punctuation.section.braces.end.vala

  documentation_deprecated_taglet:
    - match: (@deprecated)\s+
      captures:
        1: storage.type.vala

  documentation_see_taglet:
    - match: (@see)\s+({{identifier}})
      captures:
        1: storage.type.vala
        2: entity.name.section.vala

  documentation_param_taglet:
    - match: (@param)\s+({{identifier}})
      captures:
        1: storage.type.vala
        2: variable.parameter.vala

  documentation_since_taglet:
    - match: (@since)\s+
      captures:
        1: storage.type.vala

  documentation_return_taglet:
    - match: (@return)\s+
      captures:
        1: storage.type.vala

  documentation_throws_taglet:
    - match: (@throws)\s+({{identifier}})
      captures:
        1: storage.type.vala
        2: entity.name.type.vala

  # Pops out at the end of the line and handles comments.
  # Marks the rest of the line as invalid.
  option_done:
    - include: comments
    - match: $
      pop: true
    - match: \S
      scope: invalid.illegal.vala

  main:
    # Isolated member declarations (LSP hover markdown blocks, etc.)
    - match: '(?=\s*{{visibility}}\s*(?:(?:static|abstract|virtual|override|inline|async|private|protected|public|internal)\s+)*\b(?:signal|delegate)\b)'
      push: member_declaration_snippet
    - match: '(?=\s*(?:{{visibility}}\s+)?{{type_name}}\s*::\s*{{type_name}}\s*\()'
      push: member_declaration_snippet
    - match: '(?=\s*{{visibility}}\s+{{type_name}}\s*::)'
      push: member_declaration_snippet
    - match: '(?=\s*\b(?:signal|delegate)\b)'
      push: member_declaration_snippet
    - include: preprocessor
    - include: construct_block_declaration
    - include: stray_close_bracket
    - match: '\{'
      scope: punctuation.section.block.begin.vala
      push:
        - meta_scope: meta.block.vala
        - match: '\}'
          scope: punctuation.section.block.end.vala
          pop: true
        - include: main
    - include: attribute
    - include: using
    - include: class_declaration
    - include: interface_declaration
    - include: namespace_declaration
    - include: delegate_declaration
    - include: errordomain_declaration
    # allows coloration of code outside a class
    - match: (?=\S)
      push:
        - match: (?={{visibility}}|\b(?:class|delegate|errordomain|interface|namespace|readonly|static)\b)
          pop: true
        - include: line_of_code

  stray_close_bracket:
    - match: '[})\]]'
      scope: invalid.illegal.stray.brace.vala

  using:
    - match: \bglobal\b
      scope: storage.modifier.vala
    - match: '\b(using)\s+(?={{name}}\s*=\s*)'
      captures:
        1: keyword.control.import.vala
        2: meta.path.vala
        3: keyword.operator.assignment.vala
      push: using_namespace
    - match: '\b(using)(?!\s*\()(?:\s+(static))?\b'
      captures:
        1: keyword.control.import.vala
        2: keyword.control.import.vala
        3: meta.path.vala
      push: using_namespace

  namespace_alias:
    - match: '(?:(global)|({{name}}))\s*(::)'
      captures:
        1: support.namespace.vala
        2: variable.other.namespace.vala
        3: punctuation.accessor.double-colon.namespace.vala

  using_namespace:
    - include: namespace_alias
    - match: '({{name}})\s*(=)'
      captures:
        1: variable.other.namespace.vala
        2: keyword.operator.assignment.vala
    - match: '{{name}}'
      scope: entity.name.namespace.vala
    - match: \.
      scope: meta.path.vala punctuation.separator.namespace.vala
    - include: type_arguments
    - match: \,
      scope: punctuation.separator.vala
    - match: ';'
      scope: punctuation.terminator.vala
      pop: true
    - match: '[^\s;]+'
      scope: invalid.illegal.expected-namespace.vala
    - match: '$'
      pop: true

  namespace_declaration:
    # package declaration
    - match: '\b(namespace)\b'
      scope: storage.type.namespace.vala
      push:
        - meta_scope: meta.namespace.vala
        - match: '(?={{name}})'
          push:
            - meta_content_scope: entity.name.namespace.vala
            - match: '{{name}}'
            - match: \.
              scope: punctuation.separator.namespace.vala
            - match: ''
              pop: true
        - match: \{
          scope: punctuation.section.block.begin.vala
          set:
            - meta_scope: meta.namespace.vala meta.block.vala
            - match: \}
              scope: punctuation.section.block.end.vala
              pop: true
            - include: main
        - match: (?=\S)
          pop: true

  class_declaration:
    - match: '\b(static|abstract|partial|sealed|inline|override|virtual)\b'
      scope: storage.modifier.vala
    - match: '{{visibility}}'
      scope: storage.modifier.access.vala
    - include: construct_block_declaration
    - match: \b(class)\s+
      captures:
        1: storage.type.class keyword.declaration.class.vala
      push: qualified_class_declaration_name
    - match: '(?:\b(readonly)\s+)?(?:\b(ref)\s+)?\b(struct)\s+'
      captures:
        1: storage.modifier.vala
        2: storage.modifier.vala
        3: storage.type.struct keyword.declaration.struct.vala
      push: qualified_struct_declaration_name
    - match: '\b(enum)\s+({{name}})\s*(?:(:)\s*(byte|sbyte|short|ushort|int|uint|long|ulong))?'
      scope: meta.enum.vala
      captures:
        1: storage.type.enum keyword.declaration.enum.vala
        2: entity.name.enum.vala
        3: punctuation.separator.key-value.type.vala
        4: storage.type.vala
      push:
        - meta_content_scope: meta.enum.vala
        - match: (?=\{)
          set:
          - match: \{
            scope: punctuation.section.block.begin.vala
            set:
              - meta_scope: meta.enum.body.vala meta.block.vala
              - match: \}
                scope: punctuation.section.block.end.vala
                set:
                  - match: ';'
                    scope: punctuation.terminator.statement.vala
                    pop: true
                  - match: '(?=\S)'
                    pop: true
              - include: attribute
              # value list ends; arbitrary member declarations may follow
              - match: ';'
                scope: punctuation.terminator.statement.vala
                set:
                  - meta_scope: meta.enum.body.vala meta.block.vala
                  - include: data_type_trailing_members
              # A member declaration with no value list to terminate - GLib's
              # Gio-2.0-custom.vala opens `errordomain IOError {` straight onto
              # a method. Codes are plain identifiers, so a visibility or
              # declaration modifier can only mean the list is over; without
              # this the modifiers were scoped as codes and the member's own
              # closing brace ended the body.
              - match: '(?=(?:{{visibility}}|\b(?:static|abstract|virtual|override|inline|async|extern|new|sealed|const|delegate|signal)\b))'
                set:
                  - meta_scope: meta.enum.body.vala meta.block.vala
                  - include: data_type_trailing_members
              - match: '{{name}}'
                scope: constant.other.enum.vala
              - match: '='
                scope: keyword.operator.assignment.vala
                push:
                  # Stop *before* the ';' - line_of_code_in consumes it, and
                  # then the rule above never gets to switch into the
                  # trailing-member list, so `BAD = 23;` followed by a method
                  # left every later member scoped as an enum/error code.
                  - match: '(?=[;,}])'
                    pop: true
                  - include: line_of_code_in
              - match: ','
                scope: punctuation.separator.enum.vala

  errordomain_declaration:
    - match: '{{visibility}}'
      scope: storage.modifier.access.vala
    - match: '\b(static|abstract|extern)\b'
      scope: storage.modifier.vala
    - match: '\b(errordomain)\s+({{name}})'
      scope: meta.errordomain.vala
      captures:
        1: storage.type.errordomain keyword.declaration.errordomain.vala
        2: entity.name.errordomain.vala
      push:
        - meta_content_scope: meta.errordomain.vala
        - match: (?=\{)
          set:
          - match: \{
            scope: punctuation.section.block.begin.vala
            set:
              - meta_scope: meta.errordomain.body.vala meta.block.vala
              - match: \}
                scope: punctuation.section.block.end.vala
                set:
                  - match: ';'
                    scope: punctuation.terminator.statement.vala
                    pop: true
                  - match: '(?=\S)'
                    pop: true
              - include: attribute
              # code list ends; arbitrary member declarations may follow
              - match: ';'
                scope: punctuation.terminator.statement.vala
                set:
                  - meta_scope: meta.errordomain.body.vala meta.block.vala
                  - include: data_type_trailing_members
              # A member declaration with no value list to terminate - GLib's
              # Gio-2.0-custom.vala opens `errordomain IOError {` straight onto
              # a method. Codes are plain identifiers, so a visibility or
              # declaration modifier can only mean the list is over; without
              # this the modifiers were scoped as codes and the member's own
              # closing brace ended the body.
              - match: '(?=(?:{{visibility}}|\b(?:static|abstract|virtual|override|inline|async|extern|new|sealed|const|delegate|signal)\b))'
                set:
                  - meta_scope: meta.errordomain.body.vala meta.block.vala
                  - include: data_type_trailing_members
              - match: '{{name}}'
                scope: constant.other.errordomain.vala
              - match: '='
                scope: keyword.operator.assignment.vala
                push:
                  # Stop *before* the ';' - line_of_code_in consumes it, and
                  # then the rule above never gets to switch into the
                  # trailing-member list, so `BAD = 23;` followed by a method
                  # left every later member scoped as an enum/error code.
                  - match: '(?=[;,}])'
                    pop: true
                  - include: line_of_code_in
              - match: ','
                scope: punctuation.separator.errordomain.vala

  interface_declaration:
    - match: '(interface)\s+'
      captures:
        1: storage.type.interface keyword.declaration.interface.vala
      push: qualified_interface_declaration_name

  delegate_declaration:
    - match: \b(delegate)\b\s+
      captures:
        1: storage.type keyword.declaration.function.vala
      push: delegate_type

  delegate_type:
    - meta_scope: meta.delegate.vala
    - match: \s
      set: delegate_name
    - include: type

  delegate_name:
    - match: '\s+'
      scope: meta.delegate.vala
    - match: '({{name}})(\s*)(<)'
      captures:
        1: meta.delegate.vala variable.other.member.delegate.vala
        2: meta.delegate.vala
        3: meta.delegate.vala meta.generic.vala punctuation.definition.generic.begin.vala
      set:
        - meta_content_scope: meta.delegate.vala meta.generic.vala
        - match: '>'
          scope: meta.delegate.vala meta.generic.vala punctuation.definition.generic.end.vala
          set:
            - match: '\s+'
              scope: meta.delegate.vala
            - match: \(
              scope: meta.delegate.parameters.vala punctuation.section.parameters.begin.vala
              set: delegate_params
        - include: inside_type_parameter
    - match: '({{name}})(\s*)(\()'
      captures:
        1: meta.delegate.vala variable.other.member.delegate.vala
        2: meta.delegate.vala
        3: meta.delegate.parameters.vala punctuation.section.parameters.begin.vala
      set: delegate_params
    - match: '(?=\S)'
      pop: true

  delegate_params:
    - meta_content_scope: meta.delegate.parameters.vala
    - match: \)
      scope: punctuation.section.parameters.end.vala
      set: delegate_end
    - match: (?=\S)
      push: [method_param, method_param_type]

  delegate_end:
    # Parser.parse_delegate_declaration takes a throws clause before the ';'
    - match: (?=throws\b)
      push: method_throws_clause
    - match: '\s+'
    - match: ';'
      scope: punctuation.terminator.vala
      pop: true
    - match: (\s+(?=\S)|\S)
      scope: invalid.illegal.expected.colon
      pop: true

  struct_signature:
    - meta_scope: meta.struct.vala
    - include: data_type_signature
    - match: '(?=\s*\{)'
      set: [struct_body, data_type_body]

  class_signature:
    - meta_scope: meta.class.vala
    - include: data_type_signature
    - match: '(?=\s*\{)'
      set: [class_body, data_type_body]

  interface_signature:
    - meta_scope: meta.interface.vala
    - include: data_type_signature
    - match: '(?=\s*\{)'
      set: [interface_body, data_type_body]

  struct_body:
    - meta_content_scope: meta.struct.body.vala
    - match: ''
      pop: true

  class_body:
    - meta_content_scope: meta.class.body.vala
    - match: ''
      pop: true

  interface_body:
    - meta_content_scope: meta.interface.body.vala
    - match: ''
      pop: true

  # enum/errordomain bodies allow arbitrary member declarations (methods,
  # constructors, ...) after the value list's terminating ';' -
  # Parser.parse_enum_declaration / parse_errordomain_declaration both do
  # `if (accept (SEMICOLON)) { while (current () != CLOSE_BRACE) parse_declaration (...); }`
  data_type_trailing_members:
    - match: \}
      scope: punctuation.section.block.end.vala
      set:
        - match: ';'
          scope: punctuation.terminator.statement.vala
          pop: true
        - match: '(?=\S)'
          pop: true
    - include: attribute
    - include: construct_block_declaration
    - include: method_declaration
    - include: stray_close_bracket

  data_type_body:
    # We are entered on a `(?=\s*\{)` lookahead, so the position is usually on
    # the space before the brace. Skip it explicitly: the fallback below used to
    # be `\S*`, which matches the empty string on whitespace and popped the
    # whole class/interface body before the `\{` rule ever ran - `class Foo {`
    # fell through to main's generic brace handler (no member declarations,
    # so constructors read as function calls), while `class Foo{` worked.
    - match: '\s+'
    # `set`, not `push`: once the body's closing brace pops we must leave this
    # context too, otherwise it stays on the stack and flags the next member of
    # the *enclosing* type as invalid.
    - match: \{
      scope: punctuation.section.block.begin.vala
      set:
        - meta_scope: meta.block.vala
        - match: \}
          scope: punctuation.section.block.end.vala
          pop: true
        - include: preprocessor
        - include: attribute
        - include: class_declaration
        - include: interface_declaration
        - include: delegate_declaration
        - include: errordomain_declaration
        - include: construct_block_declaration
        - include: method_declaration
        - include: stray_close_bracket
    - match: \S
      scope: invalid.illegal
      pop: true

  data_type_signature:
    - include: maybe_type_parameters
    - match: '\s*:\s*'
      scope: punctuation.separator.type.vala
      push: type_constraint
    - match: '\s+where\b'
      push: type_constraint

  type_constraint:
    - match: '(?={{namespaced_type_name}})'
      push: namespaced_inherited_class_path
    - include: type_constraint_common
    - match: '{{type_name}}'
      scope: entity.other.inherited-class.vala
    - match: '{{name}}'
      scope: entity.other.inherited-class.vala
    - match: '(?=\s*[,{])'
      pop: true

  type_constraint_common:
    - match: '\b(where)\s+(?:({{base_type}})|({{name}}))\s*(:)'
      captures:
        1: storage.modifier.vala
        2: storage.type.vala
        3: support.type.vala
        4: punctuation.separator.type.vala
    - match: '(?:(global)|({{name}}))\s*(::)'
      captures:
        1: support.namespace.vala
        2: meta.path.vala
        3: punctuation.accessor.double-colon.namespace.vala
    - match: '(class|struct|interface)'
      scope: storage.type.vala
    - match: 'new\s*\(\s*\)'
      scope: keyword.operator.new.vala
    - match: '{{base_type}}'
      scope: storage.type.vala
    - match: ','
      scope: punctuation.separator.inherited-class.vala

  signal_handler_declaration:
    - match: '({{name}})(\.)'
      captures:
        1: entity.other.inherited-class.vala
        2: punctuation.accessor.dot.vala
    - match: '{{name}}'
      scope: entity.name.function.signal.vala
      set:
        - match: '\s*(\()'
          captures:
            1: meta.function.parameters.vala punctuation.section.parameters.begin.vala
          push: [signal_handler_after_params, method_params]
        - match: '\s*;'
          scope: punctuation.terminator.statement.vala
          pop: true
        - match: '\s*\{'
          scope: punctuation.section.block.begin.vala
          push: signal_handler_body
        - match: (?==)
          set: member_variables_declaration
        - match: (?=\S)
          pop: true
    - match: (?=\S)
      pop: true

  signal_handler_body:
    - meta_scope: meta.block.vala
    - match: \}
      scope: punctuation.section.block.end.vala
      pop: 2
    - match: \b(add)\b
      scope: keyword.declaration.function.accessor.add.vala
      push: method_body
    - match: \b(remove)\b
      scope: keyword.declaration.function.accessor.remove.vala
      push: method_body
    - include: code_block_in

  signal_handler_after_params:
    - match: '\s*;'
      scope: punctuation.terminator.statement.vala
      pop: 2
    - match: '\s*\{'
      scope: punctuation.section.block.begin.vala
      push: signal_handler_body
    - match: '(?=\s*$)'
      pop: 2

  member_declaration_snippet:
    - meta_content_scope: meta.class.body.vala meta.block.vala
    - include: attribute
    - include: method_declaration
    - match: '(?=\s*$)'
      pop: true

  method_declaration:
    - match: '\b(?:abstract|async|const|extern|inline|new|override|partial|ref|sealed|static|virtual|volatile)\b'
      scope: storage.modifier.vala
    - match: \b(signal)\b\s+
      captures:
        1: keyword.declaration.signal.vala
      push: [signal_handler_declaration, type_no_space]
    - match: \bdelegate\b
      scope: storage.type keyword.declaration.function.vala
    - match: '{{visibility}}'
      scope: storage.modifier.access.vala
    - match: '{{ownership}}'
      scope: storage.modifier.ownership.vala
    - match: '\boperator\b'
      scope: storage.modifier.vala
      push: method_name_or_member_variable
    - match: '({{name}})\s*(<)'
      captures:
        1: support.type.vala
        2: meta.generic.vala punctuation.definition.generic.begin.vala
      push: [method_name_or_member_variable, inside_type_argument]
    - match: '(~{{name}})(\s*)(\()'
      captures:
        1: meta.function.vala entity.name.function.destructor.vala
        2: meta.function.vala
        3: meta.function.parameters.vala punctuation.section.parameters.begin.vala
      push: [constructor_prebody, method_params]
    - match: '(~)({{namespaced_type_name}})\s*(::)\s*({{name}})(\s*)(\()'
      captures:
        1: meta.function.vala
        2: support.type.vala
        3: meta.function.vala punctuation.accessor.double-colon.namespace.vala
        4: meta.function.vala entity.name.function.destructor.vala
        5: meta.function.vala
        6: meta.function.parameters.vala punctuation.section.parameters.begin.vala
      push: [constructor_prebody, method_params]
    - match: '(~)({{type_name}})\s*(::)\s*({{name}})(\s*)(\()'
      captures:
        1: meta.function.vala
        2: support.type.vala
        3: meta.function.vala punctuation.accessor.double-colon.namespace.vala
        4: meta.function.vala entity.name.function.destructor.vala
        5: meta.function.vala
        6: meta.function.parameters.vala punctuation.section.parameters.begin.vala
      push: [constructor_prebody, method_params]
    - match: '({{namespaced_type_name}})\s*(::)\s*((?!{{reserved}}\b){{name}})\s*(\()'
      captures:
        1: support.type.vala
        2: punctuation.accessor.double-colon.namespace.vala
        3: entity.name.function.constructor.vala
        4: meta.function.parameters.vala punctuation.section.parameters.begin.vala
      push: [constructor_prebody, method_params]
    - match: '({{type_name}})\s*(::)\s*((?!{{reserved}}\b){{name}})\s*(\()'
      captures:
        1: support.type.vala
        2: punctuation.accessor.double-colon.namespace.vala
        3: entity.name.function.constructor.vala
        4: meta.function.parameters.vala punctuation.section.parameters.begin.vala
      push: [constructor_prebody, method_params]
    - match: '((?!{{reserved}}\b){{name}})\s*(\()'
      captures:
        1: entity.name.function.constructor.vala
        2: meta.function.parameters.vala punctuation.section.parameters.begin.vala
      push: [constructor_prebody, method_params]
    # Named creation method - `public async Foo.async () { … }`. The segment
    # after the dot is an identifier by definition, so keywords are allowed
    # there (Parser.skip_identifier), and it must be matched in one go: the rule
    # below consumes only `Foo.`, after which `async` hit the modifier rule at
    # the top of this context and the parameter list was read as a tuple.
    - match: '({{name}})\s*(\.)\s*({{name}})\s*(\()'
      captures:
        1: support.type.vala
        2: punctuation.accessor.dot.vala
        3: entity.name.function.constructor.vala
        4: meta.function.parameters.vala punctuation.section.parameters.begin.vala
      push: [constructor_prebody, method_params]
    - match: '({{name}})\s*(\.)'
      captures:
        1: entity.other.inherited-class.vala
        2: punctuation.accessor.dot.vala
    - match: \b(?:({{base_type}})|((?!{{reserved}}\b){{name}}))
      captures:
        1: storage.type.vala
        2: support.type.vala
      push:
        - match: '{{type_suffix_capture}}'
          captures:
            1: storage.type.nullable.vala
            2: meta.brackets.vala
            3: punctuation.section.brackets.begin.vala
            4: punctuation.separator.vala
            5: punctuation.section.brackets.end.vala
            6: keyword.operator.pointer.vala
        - match: ''
          set: method_name_or_member_variable
    - match: (?=\()
      push: [method_name_or_member_variable, type_tuple]

  method_name_or_member_variable:
    - match: '\s+'
    - match: '\.'
      scope: punctuation.accessor.dot.vala
    - match: '(operator)\s*({{unary_op}}|{{bin_op}})\s*(\()'
      captures:
        1: storage.modifier.other.vala
        2: meta.function.vala entity.name.function.vala
        3: meta.function.parameters.vala punctuation.section.parameters.begin.vala
      set: method_params_declaration
    - match: (?={{name}})
      branch_point: method_or_member_variable_name
      branch:
        - method_name
        - member_lambda_or_plain
      pop: true

  member_lambda_or_plain:
    - match: ({{name}})\s*(=>)
      scope: meta.function.vala
      captures:
        1: variable.other.member.vala
        2: keyword.declaration.function.accessor.get.vala
      set:
        - meta_scope: meta.property.vala
        - meta_content_scope: meta.function.vala
        - include: line_of_code_in
    - match: (?={{namespaced_name}}\s+{{name}}\s+=>)
      pop: true
    - match: '{{name}}(?!\s*\()'
      scope: variable.other.member.vala
    - match: (?==[^>])
      set: member_variables_declaration
    - match: ';'
      scope: punctuation.terminator.statement.vala
      pop: true
    - match: (?=\})
      pop: true
    - match: (?=\s*\()
      fail: method_or_member_variable_name
    - match: (?=\S)
      fail: method_or_member_variable_name

  method_name:
    - match: '({{name}})\s*(\()'
      captures:
        1: meta.function.vala entity.name.function.vala
        2: meta.function.parameters.vala punctuation.section.parameters.begin.vala
      set: method_params_declaration
    - match: '({{name}})\s*(<)(?=[^(]*>\.)'
      scope: meta.function.vala
      captures:
        1: entity.other.inherited-class.vala
        2: meta.generic.vala punctuation.definition.generic.begin.vala
      push:
        - meta_content_scope: meta.function.vala meta.generic.vala
        - match: '(>)\s*(\.)'
          scope: meta.function.vala meta.generic.vala
          captures:
            1: punctuation.definition.generic.end.vala
            2: punctuation.accessor.dot.vala
          pop: true
        - match: ','
          scope: punctuation.separator.parameter.type.vala
        - include: type
    - match: '({{name}})\s*(<)'
      captures:
        1: entity.name.function.vala
        2: meta.generic.vala punctuation.definition.generic.begin.vala
      push:
        - meta_scope: meta.function.vala
        - meta_content_scope: meta.generic.vala
        - include: inside_type_parameter
    # Parameter list of a generic method — `void sort<G> (…)`. The type
    # parameter context above pops on '>', so the '(' arrives here with no
    # preceding name, and every other rule in this context requires one. Without
    # this the parameter list is re-read as a declaration, the body's '{' never
    # opens a block, and every later brace is off by one.
    - match: '\s*(\()'
      captures:
        1: meta.function.parameters.vala punctuation.section.parameters.begin.vala
      set: method_params_declaration
    - match: '(this)\s*(\[)'
      captures:
        1: variable.language.vala
        2: meta.brackets.vala punctuation.section.brackets.begin.vala
      set: [method_accessor, method_params_bracket]
    - match: '({{name}})\s*(\.)'
      scope: meta.function.vala
      captures:
        1: entity.other.inherited-class.vala
        2: punctuation.accessor.dot.vala
    # `const OptionEntry[] options = { … };` is a field with an initializer, not
    # a property. This branch has no rule for `=`, so it used to skip over it and
    # take the `{` for an accessor block - which then closed on the first `}` of
    # a nested element. Hand those to member_lambda_or_plain, which routes to
    # member_variables_declaration. `=>` stays here: it is a lambda property.
    - match: '(?={{name}}\s*=(?!>|=))'
      fail: method_or_member_variable_name
    - match: '{{name}}(?!\s*\()'
      scope: meta.property.vala variable.other.member.vala
      push:
        - match: \s*(,)
          captures:
            1: punctuation.separator.variables.vala
          pop: true
        - match: '(?=\s*[\{;])'
          pop: true
    - match: '(?=\s*\{)'
      set: method_accessor
    - match: ';'
      scope: punctuation.terminator.statement.vala
      pop: true

  method_params_declaration:
    - meta_content_scope: meta.function.parameters.vala
    - match: \)
      scope: meta.function.parameters.vala punctuation.section.parameters.end.vala
      set: method_body
    - match: (?=\S)
      push: [method_param, method_param_type]

  method_params:
    - meta_content_scope: meta.function.parameters.vala
    - match: \)
      scope: meta.function.parameters.vala punctuation.section.parameters.end.vala
      pop: true
    - match: (?=\S)
      push: [method_param, method_param_type]

  method_params_bracket:
    - meta_content_scope: meta.brackets.vala
    - match: \]
      scope: meta.brackets.vala punctuation.section.brackets.end.vala
      pop: true
    - match: (?=\S)
      push: [method_param, method_param_type]

  method_param:
    - match: '{{name}}'
      scope: variable.parameter.vala
    - match: '='
      scope: keyword.operator.assignment.default-value.vala
      push: line_of_code_in
    - match: ','
      scope: punctuation.separator.parameter.function.vala
      pop: true
    - match: (?=\}|\)|>|\]|;)
      pop: true

  method_param_type:
    - include: attribute
    - match: (?=[^\s\[])
      set:
      - match: '{{ownership}}\s+'
        scope: storage.modifier.ownership.vala
      - match: '\b(?:out|ref|this|params|in|dynamic)\b\s+'
        scope: storage.modifier.parameter.vala
      - match: \s
        pop: true
      - include: type
    - match: (?=\}|\)|>|\]|;)
      pop: true

  constructor_prebody:
    - meta_scope: meta.function.vala
    - match: ':'
      scope: meta.function.vala punctuation.separator.function.vala
      set:
        - match: \s+
          scope: meta.function.vala
        - match: '(this|base)\s*(\.)\s*((?!{{reserved}}\b){{name}})\s*(\()'
          captures:
            1: variable.language.vala
            2: punctuation.accessor.dot.vala
            3: entity.name.function.constructor.vala
            4: meta.group.vala punctuation.section.group.begin.vala
          set: [constructor_initializer, arguments]
        - match: (this|base)\s*(\()
          captures:
            1: variable.language.vala
            2: meta.group.vala punctuation.section.group.begin.vala
          set: [constructor_initializer, arguments]
        - match: '(?=\{)'
          set: method_body
    - match: '\s*;'
      scope: punctuation.terminator.statement.vala
      pop: true
    - match: '(?=\{|=>)'
      set: method_body
    # The brace is often on the line after the parameter list (libvaladoc does
    # this throughout). Popping straight away at end of line meant the body was
    # never entered and its statements were read as member declarations, so
    # look at the next line before giving up on finding one.
    - match: '(?=\s*$)'
      set: constructor_prebody_next_line

  constructor_prebody_next_line:
    - meta_scope: meta.function.vala
    - match: '\s+'
    - match: '(?=\{|=>)'
      set: method_body
    - match: ';'
      scope: punctuation.terminator.statement.vala
      pop: true
    - match: '(?=\S)'
      pop: true

  constructor_initializer:
    - meta_scope: meta.function.vala
    - meta_content_scope: meta.group.vala
    - match: '\)'
      scope: punctuation.section.group.end.vala
    - match: ''
      set: constructor_initializer_after

  constructor_initializer_after:
    - meta_content_scope: meta.function.vala
    - match: '(?=\{)'
      set: method_body
    - match: '(?=\S)'
      pop: true

  method_body_brace_block:
    - match: \}
      scope: punctuation.section.block.end.vala
      pop: true
    - include: stray_close_bracket

  method_body:
    - meta_scope: meta.function.vala
    - match: (?=where\b)
      scope: storage.modifier.other.vala
      push: type_constraint
    - match: (?=throws\b)
      push: method_throws_clause
    - match: (?=requires\b|ensures\b)
      push: method_contract_tail
    - match: (=>)
      scope: keyword.declaration.function.arrow.vala
      set:
        - meta_content_scope: meta.function.vala
        - include: line_of_code_in
    - match: '(?=\{)'
      set:
        - match: \{
          scope: punctuation.section.block.begin.vala
          set:
            - meta_scope: meta.function.vala meta.block.vala
            - include: method_body_brace_block
            - include: code_block_in
    - match: ;
      scope: punctuation.terminator.vala
      pop: true
    - match: \S+
      scope: invalid.illegal.vala
      pop: true

  property_setter_implicit_value:
    - match: (?<!\.)\b(value)\b
      scope: variable.language.vala

  property_setter_body:
    - meta_scope: meta.function.vala
    - match: (?=where\b)
      scope: storage.modifier.other.vala
      push: type_constraint
    - match: (?=throws\b)
      push: method_throws_clause
    - match: (?=requires\b|ensures\b)
      push: method_contract_tail
    - match: (=>)
      scope: keyword.declaration.function.arrow.vala
      set:
        - meta_content_scope: meta.function.vala
        - include: property_setter_implicit_value
        - include: line_of_code_in
    - match: '(?=\{)'
      set:
        - match: \{
          scope: punctuation.section.block.begin.vala
          set:
            - meta_scope: meta.function.vala meta.block.vala
            - include: method_body_brace_block
            - include: property_setter_implicit_value
            - include: code_block_in
    - match: ;
      scope: punctuation.terminator.vala
      pop: true
    - match: \S+
      scope: invalid.illegal.vala
      pop: true

  method_throws_clause:
    - meta_content_scope: meta.function.vala
    - match: \bthrows\b
      scope: keyword.control.exception.vala
    - match: (?=\s*\{|\s*;|\s*=>)
      pop: true
    - match: '(?={{namespaced_type_name}}\s*[,;{])'
      push: namespaced_type_path
    - match: ','
      scope: punctuation.separator.type.vala
    - match: '{{type_name}}'
      scope: support.type.vala
    - match: '{{name}}'
      scope: support.type.vala
    - match: \s+

  method_contract_tail:
    - meta_content_scope: meta.function.vala
    - match: (?=\s*\{|\s*;|\s*=>)
      pop: true
    - match: \b(requires|ensures)\b
      scope: keyword.control.conditional.vala
    - include: line_of_code_in_no_semicolon

  method_accessor:
    - meta_scope: meta.property.vala
    - match: \{
      scope: meta.block.vala punctuation.section.block.begin.vala
      set:
        - meta_content_scope: meta.property.vala meta.block.vala
        - match: \}
          scope: punctuation.section.block.end.vala
          set:
            - meta_content_scope: meta.property.vala
            - match: =
              scope: keyword.operator.assignment.vala
              set:
                - meta_content_scope: meta.property.vala
                - include: line_of_code_in
            - match: (?=\S)
              pop: true
        - match: (?:\b(readonly)\b\s+)?\b(get)\b
          captures:
            1: storage.modifier.vala
            2: keyword.declaration.function.accessor.get.vala
          push: method_body
        - match: \b(?:set\s+construct|construct\s+set)\b(?=\s*;)
          scope: keyword.declaration.function.accessor.construct.vala
        - match: \b(construct)\b(?=\s*;)
          scope: keyword.declaration.function.accessor.construct.vala
        - match: \b(?:set\s+construct|construct\s+set)\b
          scope: keyword.declaration.function.accessor.set.vala
          push: property_setter_body
        - match: \b(construct)\b
          scope: keyword.declaration.function.accessor.construct.vala
          push: property_setter_body
        - match: \b(?:set|init)\b
          scope: keyword.declaration.function.accessor.set.vala
          push: property_setter_body
        # the bodyless accessor rules above stop at the `;`, so terminate it here
        - match: ';'
          scope: punctuation.terminator.vala
        - match: \bdefault\b\s*=
          scope: keyword.other.vala
          push: line_of_code_in
        - match: '{{visibility}}'
          scope: storage.modifier.access.vala
        - include: attribute
    - match: '=>'
      scope: keyword.declaration.function.arrow.vala
      set:
        - meta_content_scope: meta.function.vala
        - include: line_of_code_in
    - match: \S
      scope: invalid.illegal.vala
      pop: true

  attribute:
    - match: (\[)\s*(assembly|module|field|event|method|param|property|return|type)\s*(:)
      captures:
        1: punctuation.definition.annotation.begin.vala
        2: storage.modifier.target.vala
        3: punctuation.separator.key-value.vala
      push: attribute_in
    - match: \[
      scope: punctuation.definition.annotation.begin.vala
      push: attribute_in

  attribute_in:
    - meta_scope: meta.annotation.vala
    - match: '({{name}})\s*(\()'
      captures:
        1: variable.annotation.vala
        2: meta.group.vala punctuation.section.group.begin.vala
      set: [attribute_arguments, arguments]
    - match: '({{name}})\s*(\.)'
      captures:
        1: variable.other.namespace.vala
        2: punctuation.accessor.dot.namespace.vala
    - match: '(?:(global)|({{name}}))\s*(::)'
      captures:
        1: support.namespace.vala
        2: support.namespace.vala
        3: punctuation.accessor.double-colon.namespace.vala
    - match: '{{name}}'
      scope: variable.annotation.vala
    - match: ','
      scope: punctuation.separator.annotation.vala
    - match: \]
      scope: punctuation.definition.annotation.end.vala
      pop: true

  code_block_in:
    # Has to be tried here, at column 0. The `preprocessor` include inside
    # line_of_code is unreachable for indented directives: the rule below skips
    # the indent before pushing, and `^\s*(#)` can then never match.
    - include: preprocessor
    - match: (?=\S)
      push: line_of_code

  line_of_code:
    - include: preprocessor
    # language keywords
    # These statements all `expect (OPEN_PARENS)` in the parser, so require the
    # paren: without it a keyword used as an identifier (`switch = 2;` - legal,
    # Parser.skip_identifier) took the statement branch.
    - match: \b(if)\b(?=\s*\()
      captures:
        1: keyword.control.conditional.if.vala
      set: [else_block, if_block, if_condition]
    - match: \b(switch)\b(?=\s*\()
      captures:
        1: keyword.control.switch.vala
      set: [switch_block, if_condition]
    # `for (Type x = …` / `for (var x = …` - the init clause is a declaration.
    # Requiring the *second* identifier keeps `for (void_method (); …)` out:
    # it used to take this branch and read the call's name as a type.
    - match: \b(for)\s*(\()(?=(?:{{name}}\s+{{name}}|var\s+{{name}}))
      captures:
        1: keyword.control.for.vala
        2: meta.group.vala punctuation.section.group.begin.vala
      set: [for_block, line_of_code_in, line_of_code_in, for_var_assignment, var_declaration]
    - match: \b(for)\s*(\()
      captures:
        1: keyword.control.for.vala
        2: meta.group.vala punctuation.section.group.begin.vala
      set: [for_block, line_of_code_in, line_of_code_in, line_of_code_in]
    - match: \b(foreach)\s*(\()
      captures:
        1: keyword.control.foreach.vala
        2: meta.group.vala punctuation.section.group.begin.vala
      set: [for_block, foreach_var_assignment, foreach_header]
    - match: \b(try)\b
      scope: keyword.control.try.vala
      set: [finally_block, catch_expr, try_block]
    - include: construct_block_declaration
    - match: \b(using)\s*(\()
      captures:
        1: keyword.control.using.vala
        2: meta.group.vala punctuation.section.group.begin.vala
      set: [using_block, line_of_code]
    - match: \b(using)\s*
      captures:
        1: keyword.control.using.vala
      push: var_declaration
    - match: \b(delete)\b
      scope: keyword.control.vala
      set: line_of_code_in
    - match: \b(lock)\s*(\()
      captures:
        1: keyword.control.other.lock.vala
        2: meta.group.vala punctuation.section.group.begin.vala
      set: [expression_block, line_of_code]
    - match: \b(unlock)\s*(\()
      captures:
        1: keyword.control.other.unlock.vala
        2: meta.group.vala punctuation.section.group.begin.vala
      set: [expression_block, line_of_code]
    - match: \bdo\b
      scope: keyword.control.do.vala
      set: [do_condition, while_block]
    - match: \bwhile\b(?=\s*\()
      scope: keyword.control.while.vala
      set: [while_block, while_condition]
    - match: \b(else|case|catch|finally)\b
      scope: keyword.control.vala invalid.illegal.unexpected.keyword.vala
    - match: \b(return|yield\s+return)\b
      scope: keyword.control.return.vala
      set: line_of_code_in
    - match: \byield\b
      scope: keyword.other.vala
      set: line_of_code_in
    - match: \b(continue|break|yield\s+break)\b\s*(;)?
      captures:
        1: keyword.control.break.vala
        2: punctuation.terminator.statement.vala
      pop: true
    - match: \b(throw)\b
      scope: keyword.control.throw.vala
      set: line_of_code_in
    - match: \b(goto)\s+(case)\b
      captures:
        1: keyword.control.goto.vala
        2: keyword.control.switch.case.vala
      set: line_of_code_in
    - match: '\b(goto)\s+({{name}})\s*(;)'
      captures:
        1: keyword.control.goto.vala
        2: constant.other.label.vala
        3: punctuation.terminator.statement.vala
      pop: true
    - include: keywords
    # C#7/9, nested method
    - match: (?=(?:\b(?:async|ref)\s+)?(?:\bstatic\s+)?{{namespaced_name}}{{type_suffix}}\s+{{namespaced_name}}\s*\()
      push:
        - include: method_declaration
        - match: ''
          pop: true
    - match: ({{name}})\s*(?={{generic_declaration}}\()(<)
      scope: meta.function-call.vala
      captures:
        1: variable.function.vala
        2: meta.generic.vala punctuation.definition.generic.begin.vala
      push:
        - meta_content_scope: meta.generic.vala
        - match: ','
          scope: punctuation.separator.type.vala
        # The argument list has to be consumed here. Popping on a bare '>' hands
        # `(a, b)` back to line_of_code, which cannot start a statement with '('
        # and flags the closing paren as a stray brace.
        - match: '(>)\s*(\()'
          captures:
            1: meta.generic.vala punctuation.definition.generic.end.vala
            2: meta.group.vala punctuation.section.group.begin.vala
          set: [function_call_arguments, arguments]
        - match: '>'
          scope: meta.generic.vala punctuation.definition.generic.end.vala
          pop: true
        - include: type
    - match: '({{name}})(<)'
      captures:
        1: support.type.vala
        2: meta.generic.vala punctuation.definition.generic.begin.vala
      set:
        - meta_content_scope: meta.generic.vala
        - match: '>'
          scope: meta.generic.vala punctuation.definition.generic.end.vala
          set:
            - match: \.
              set: line_of_code
              scope: punctuation.accessor.dot.namespace.vala
            # `List<G>? l = …`, `List<G>[] a = …` — a type suffix after the
            # generic still leaves a variable declaration. Without this the
            # `?` fell through to line_of_code as a ternary operator and the
            # generic frame stayed on the stack, desyncing every later brace.
            - match: '{{type_suffix_capture}}(?=\s+{{name}})'
              captures:
                1: storage.type.nullable.vala
                2: meta.brackets.vala
                3: punctuation.section.brackets.begin.vala
                4: punctuation.separator.vala
                5: punctuation.section.brackets.end.vala
                6: keyword.operator.pointer.vala
              set: variables_declaration
            - match: \s+
              set: variables_declaration
            - match: (?=\S)
              set: line_of_code
        - include: inside_type_argument
    - match: '(\bconst\b)\s+(?={{namespaced_name}}{{type_suffix}}\s+{{name}}(?!\s*(?:[(:])))'
      captures:
        1: storage.modifier.vala
      set: [variables_declaration_const, type_no_space]
    # NB: a keyword is a perfectly good local variable name here.
    # Parser.skip_identifier accepts every reserved word as an identifier
    # ("also accept keywords as identifiers where there is no conflict"), and
    # vala's own sources rely on it — `var params = new ArrayList<Parameter> ()`
    # in valagenieparser.vala. The C# grammar this was ported from flagged that
    # as illegal; Vala does not.
    - match: '(var|dynamic)\s+({{name}})\s*(=)'
      captures:
        1: storage.type.variable.vala
        2: variable.other.vala
        3: keyword.operator.assignment.variable.vala
      set: line_of_code_in
    - match: (?=var\s*\()
      push: var_declaration
    - include: lambdas
    - match: (\bref\s+(?:readonly\s+)?)?\b(?={{namespaced_name}}{{type_suffix}}\s+{{name}}(?!\s*(?:[(:])))
      captures:
        1: storage.modifier.vala
      set: [variables_declaration, type_no_space]
    - match: '({{name}})\s*(:)(?!:)'
      captures:
        1: entity.name.label.vala
        2: punctuation.separator.vala
      pop: true
    - include: namespace_alias
    - match: '((?!{{reserved}}\b){{name}})\s+((?!{{reserved}}\b){{name}})'
      captures:
        1: support.type.vala
        2: variable.other.vala
      set: variables_declaration
    - match: '(?=\S)'
      set: line_of_code_in

  lambdas:
    - match: ({{name}})\s+(=>)\s*
      captures:
        1: variable.parameter.vala
        2: keyword.declaration.function.arrow.vala
      push:
        - meta_scope: meta.function.anonymous.vala
        - match: '(?=;)'
          pop: true
        - include: line_of_code_in
    - include: parenthesized_lambdas

  parenthesized_lambdas:
    - match: \((?=[^()]*\)\s+=>)
      scope: meta.function.anonymous.vala meta.group.vala punctuation.section.group.begin.vala
      push:
        - meta_content_scope: meta.function.anonymous.vala meta.group.vala
        - match: '{{name}}(?=\s*[\),/])'
          scope: variable.parameter.vala
        - match: ','
          scope: punctuation.separator.parameter.function.vala
        - match: (\))\s*(=>)
          captures:
            1: meta.group.vala punctuation.section.group.end.vala
            2: keyword.declaration.function.arrow.vala
          set:
            - meta_content_scope: meta.function.anonymous.vala
            - match: '(?=;)'
              pop: true
            - include: line_of_code_in

  inline_fixed_array_length:
    - meta_content_scope: meta.brackets.vala
    - match: '(\d+)'
      scope: constant.numeric.integer.decimal.vala
    - match: '(:)'
      scope: punctuation.separator.type.vala
      push: type_no_space
    - match: '(\])'
      scope: punctuation.section.brackets.end.vala
      pop: true

  member_variables_declaration:
    - match: '='
      scope: keyword.operator.assignment.variable.vala
      push:
        - match: (?=;|,)
          pop: true
        - include: line_of_code_in
    - match: '(?=\{)'
      push: method_accessor
    - match: '{{name}}'
      scope: variable.other.member.vala
    - match: '(\[)'
      scope: meta.brackets.vala punctuation.section.brackets.begin.vala
      push: inline_fixed_array_length
    - match: ','
      scope: punctuation.separator.variables.vala
    - match: ';'
      scope: punctuation.terminator.statement.vala
      pop: true
    - match: (?=[]})>;])
      pop: true

  variables_declaration_const:
    - match: '='
      scope: keyword.operator.assignment.variable.vala
      push:
        - match: (?=;|,)
          pop: true
        - match: (?=\{)
          push:
            - match: (?=[^,\s{}])
              pop: true
            - include: initializer_constructor
        - include: line_of_code_in
    - match: '{{name}}'
      scope: constant.other.vala
    - match: '(\[)'
      scope: meta.brackets.vala punctuation.section.brackets.begin.vala
      push: inline_fixed_array_length
    - match: ','
      scope: punctuation.separator.variables.vala
    - match: ';'
      scope: punctuation.terminator.statement.vala
      pop: true
    - match: (?=\{|\)|>)
      pop: true

  variables_declaration:
    - match: '='
      scope: keyword.operator.assignment.variable.vala
      push:
        - match: (?=;|,)
          pop: true
        - match: (?=\{)
          push:
            - match: (?=[^,\s{}])
              pop: true
            - include: initializer_constructor
        - include: line_of_code_in
    - match: '{{name}}'
      scope: variable.other.vala
    - match: '(\[)'
      scope: meta.brackets.vala punctuation.section.brackets.begin.vala
      push: inline_fixed_array_length
    - match: ','
      scope: punctuation.separator.variables.vala
    - match: ';'
      scope: punctuation.terminator.statement.vala
      pop: true
    - match: (?=\{|\)|>)
      pop: true

  keywords:
    - match: '\b(Object)\s*(\()'
      scope: meta.gobject-construction.vala
      captures:
        1: support.type.vala
        2: meta.group.vala punctuation.section.group.begin.vala
      push: gobject_constructor_arguments
    - match: \b(sizeof|typeof)\b
      scope: keyword.operator.vala
    - match: \b(requires|ensures)\b
      scope: keyword.control.conditional.vala
    - match: '\b(this|base)\s*(\[)'
      captures:
        1: variable.language.vala
        2: meta.brackets.vala punctuation.section.brackets.begin.vala
      push: accessor_arguments
    - match: \b(this|base)\b
      scope: variable.language.vala
    - match: '{{ownership}}'
      scope: storage.modifier.ownership.vala
    - match: \bdynamic\b
      scope: storage.modifier.vala
    - match: \b(typeof)(\()
      captures:
        1: keyword.operator.vala
        2: meta.group.vala punctuation.section.group.begin.vala
      push:
        - meta_content_scope: meta.group.vala
        - match: \)
          scope: meta.group.vala punctuation.section.group.end.vala
          pop: true
        - include: type
    # valaparser.parse_type_check_expression: only `is` / `as`, no `is not`
    - match: \b(as|is)\s+
      captures:
        1: keyword.operator.vala
      push: [maybe_pattern_matching_object, type_no_space]
    - match: \b(new)\b
      scope: meta.instance.vala keyword.operator.new.vala
      push: maybe_an_anonymous_class
    - match: \b(with)\b
      scope: keyword.other.vala
    - match: '{{visibility}}'
      scope: storage.modifier.access.vala

  maybe_an_anonymous_class:
    - meta_content_scope: meta.instance.vala
    - match: \{
      scope: punctuation.section.block.begin.vala
      # Found an anonymous class
      set:
        - meta_scope: meta.instance.vala meta.class.body.anonymous.vala meta.block.vala
        - match: \}
          scope: punctuation.section.block.end.vala
          pop: true
        - match: ','
          scope: punctuation.separator.class.vala
        - match: '({{name}})\s*(=)'
          captures:
            1: variable.other.member.vala
            2: keyword.operator.assignment.vala
          push: line_of_code_in
        - match: (?=\S)
          push: line_of_code_in
    - match: (?=[^{\s])
      # This is not an anonymous class
      set:
        - meta_content_scope: meta.instance.vala
        - match: '{{brackets_capture}}'
          captures:
            1: meta.brackets.vala
            2: punctuation.section.brackets.begin.vala
            3: punctuation.separator.vala
            4: punctuation.section.brackets.end.vala
        - match: \[
          scope: punctuation.section.brackets.begin.vala
          push:
            - meta_scope: meta.brackets.vala
            - match: ','
              scope: punctuation.separator.argument.vala
              push: line_of_code_in
            - match: \]
              scope: punctuation.section.brackets.end.vala
              pop: true
            - match: '(?=\S)'
              push: line_of_code_in
        - match: (?:\s*((\()\s*(\)))\s*)?(\{)
          scope: meta.instance.vala
          captures:
            1: meta.group.vala
            2: punctuation.section.group.begin.vala
            3: punctuation.section.group.end.vala
            4: meta.braces.vala punctuation.section.braces.begin.vala
          set: initializer_constructor
        - match: \(
          scope: meta.group.vala punctuation.section.group.begin.vala
          set: [constructor_arguments, arguments]
        - include: object_creation_type

  object_creation_type:
    - include: namespace_alias
    - match: '(?={{namespaced_type_name}}\s*\.)'
      push: namespaced_type_path
    - match: '(\s*\.\s*)((?!{{reserved}}\b)(?!{{type_name}}\b){{name}})(?=\s*\()'
      captures:
        1: punctuation.accessor.dot.namespace.vala
        2: entity.name.function.constructor.vala
    - match: '({{errordomain_type_name}})(\s*\.\s*)((?!{{reserved}}\b){{name}})(?=\s*\()'
      captures:
        1: support.type.vala
        2: punctuation.accessor.dot.namespace.vala
        3: constant.other.errordomain.vala
    - match: '({{type_name}})(\s*\.\s*)((?!{{reserved}}\b)(?!{{type_name}}\b){{name}})(?=\s*\()'
      captures:
        1: support.type.vala
        2: punctuation.accessor.dot.namespace.vala
        3: entity.name.function.constructor.vala
    - include: type_common
    - match: (?=\()
      push: type_tuple

  gobject_constructor_arguments:
    - meta_content_scope: meta.gobject-construction.vala meta.group.vala
    - match: \)
      scope: meta.gobject-construction.vala punctuation.section.group.end.vala
      pop: true
    - match: '({{name}})\s*(:)'
      captures:
        1: variable.parameter.construct.vala
        2: punctuation.separator.key-value.parameter.vala
      push: line_of_code_in
    - include: arguments

  line_of_code_in:
    - include: lambdas
    - include: line_of_code_in_no_semicolon
    - match: ';'
      scope: punctuation.terminator.statement.vala
      pop: true
    - match: (?=\))
      pop: true

  line_of_code_in_no_semicolon:
    - include: keywords
    - match: \b(in)\b(?!\s*[.,;+=&\|\[\]\)])
      scope: keyword.operator.word.in.vala
    # Null-safe member/index access (? then . or [); not ?? (null coalescing, in bin_op)
    - match: '\?(?=\.|\[)'
      scope: punctuation.accessor.null-safe.vala
    - match: \.\.
      scope: keyword.operator.range.vala
    - include: qualified_constant_access
    - match: '(?={{namespaced_type_name}}\s*\.)'
      push: namespaced_type_path
    # Type.method<G> (…) — qualified call with explicit type arguments. Without
    # this the name falls through to the enum-member rule below and the argument
    # list is left unparsed (stray-brace error on the closing paren).
    - match: '({{type_name}})(\s*\.\s*)((?!{{reserved}}\b){{name}})\s*(<)(?=[^(]*>\s*\()'
      scope: meta.function-call.vala
      captures:
        1: support.type.vala
        2: punctuation.accessor.dot.namespace.vala
        3: variable.function.vala
        4: meta.generic.vala punctuation.definition.generic.begin.vala
      push:
        - meta_content_scope: meta.generic.vala
        - match: ','
          scope: punctuation.separator.type.vala
        - match: '(>)\s*(\()'
          captures:
            1: meta.generic.vala punctuation.definition.generic.end.vala
            2: meta.group.vala punctuation.section.group.begin.vala
          set: [function_call_arguments, arguments]
        - include: type
    - match: '({{type_name}})(\s*\.\s*)((?!{{reserved}}\b){{name}})\s*(\()'
      scope: meta.function-call.vala
      captures:
        1: support.type.vala
        2: punctuation.accessor.dot.namespace.vala
        3: variable.function.vala
        4: meta.group.vala punctuation.section.group.begin.vala
      push: [function_call_arguments, arguments]
    - match: '({{errordomain_type_name}})(\s*\.\s*)((?!{{reserved}}\b){{name}})(?!\s*\()'
      captures:
        1: support.type.vala
        2: punctuation.accessor.dot.namespace.vala
        3: constant.other.errordomain.vala
    - match: '({{type_name}})(\s*\.\s*)((?!{{reserved}}\b){{name}})(?!\s*\()'
      captures:
        1: support.type.vala
        2: punctuation.accessor.dot.namespace.vala
        3: constant.other.enum.vala
    - match: \.
      scope: punctuation.accessor.dot.vala
    - include: parenthesized_lambdas
    # Match this before {{bin_op}} to scope specially in the generic context
    - match: '->'
      scope: punctuation.accessor.arrow.vala
    # regex literals (/pattern/flags) - must precede {{bin_op}}, or the opening
    # slash of `if (/pattern/.match (s))` is taken for a division operator. The
    # lookbehind keeps real division safe: `a / b` and `a/b` both have an
    # operand, not an operator, before the slash.
    - match: (?<=[=,({\[:;?&|+\-*/%<>!])\s*(/)(?=[^/\s])
      scope: punctuation.definition.regex.begin.vala
      push: regex_literal
    - match: '{{bin_op}}='
      scope: keyword.operator.vala
    - match: '{{bin_op}}|{{unary_op}}'
      scope: keyword.operator.vala
    - match: '='
      scope: keyword.operator.assignment.vala
    - include: literals
    - match: '({{name}})(<)(?=[^(]*>\s*\()'
      captures:
        1: variable.function.vala
        2: meta.generic.vala punctuation.definition.generic.begin.vala
      push:
        - meta_scope: meta.function-call.vala
        - meta_content_scope: meta.generic.vala
        - match: ','
          scope: punctuation.separator.type.vala
        - match: '(>)\s*(\()'
          scope: meta.function-call.vala
          captures:
            1: meta.generic.vala punctuation.definition.generic.end.vala
            2: meta.group.vala punctuation.section.group.begin.vala
          set: [function_call_arguments, arguments]
        - include: type
    - match: ({{name}})(<)(?={{namespaced_name}}>\s*\.)
      captures:
        1: support.type.vala
        2: meta.generic.vala punctuation.definition.generic.begin.vala
      push:
        - meta_content_scope: meta.generic.vala
        - match: ','
          scope: punctuation.separator.type.vala
        - match: '>'
          scope: meta.generic.vala punctuation.definition.generic.end.vala
          pop: true
        - include: type
    - match: '((?!{{reserved}}\b){{name}})\s*(\()'
      scope: meta.function-call.vala
      captures:
        1: variable.function.vala
        2: meta.group.vala punctuation.section.group.begin.vala
      push: [function_call_arguments, arguments]
    - match: '({{name}})\s*(\??\[)'
      captures:
        1: variable.other.vala
        2: meta.brackets.vala punctuation.section.brackets.begin.vala
      push: accessor_arguments
    - match: '\s*(\??\[)'
      captures:
        1: meta.brackets.vala punctuation.section.brackets.begin.vala
      push: accessor_arguments
    - match: '({{base_type}})\b'
      scope: storage.type.vala
    - match: \.emit\s*\(
      scope: keyword.other.vala
    # A switch *expression* (`x switch { … }`) needs the brace. Without the
    # lookahead a `switch` used as an identifier - legal, Parser.skip_identifier
    # accepts every keyword - pushed switch_expression, which then sat on the
    # stack swallowing the rest of the file. See
    # tests/parser/statement-keyword-as-identifier.vala.
    - match: \bswitch\b(?=\s*\{)
      scope: keyword.control.vala
      push: switch_expression
    - match: '({{reserved}})\b'
      scope: keyword.other.vala
    - match: '(?:(global)|({{name}}))\s*(::)'
      captures:
        1: support.namespace.vala
        2: support.namespace.vala
        3: punctuation.accessor.double-colon.namespace.vala
    # Unqualified imported constants (e.g. using GLib.Math; … PI)
    - match: '(?!(?:{{reserved}})\b){{constant_member}}(?!\s*\()'
      scope: constant.other.vala
    - match: '{{name}}'
      scope: variable.other.vala
    - match: '@'
      scope: invalid.illegal.reserved-char.vala
    - match: \?
      scope: keyword.operator.ternary.vala
      push:
        - match: ':'
          scope: keyword.operator.ternary.vala
          pop: true
        - include: line_of_code_in
    - match: '(\()\s*(\*)\s*({{name}})\s*(\))'
      captures:
        1: punctuation.section.group.begin.vala
        2: keyword.operator.pointer.vala
        3: variable.other.vala
        4: punctuation.section.group.end.vala
    - match: '(\()\s*(owned|unowned|weak|void|dynamic)\s*(\))'
      captures:
        1: punctuation.section.group.begin.vala
        2: storage.modifier.ownership.vala
        3: punctuation.section.group.end.vala
    - match: '(\()(?={{namespaced_name}}\s*\)(?!\s*switch\b))'
      captures:
        1: punctuation.section.group.begin.vala
      push:
        - meta_scope: meta.cast.vala
        - match: \)
          scope: punctuation.section.group.end.vala
          pop: true
        - match: '{{ownership}}'
          scope: storage.modifier.ownership.vala
        - match: '{{base_type}}'
          scope: storage.type.vala
        - match: '{{name}}'
          scope: support.type.vala
        - match: '\.'
          scope: punctuation.separator.namespace.vala
        - match: '{{type_suffix_capture}}'
          captures:
            1: punctuation.section.brackets.begin.vala
            2: punctuation.separator.vala
            3: punctuation.section.brackets.end.vala
            4: keyword.operator.pointer.vala
    - match: (?=\()
      branch_point: tuple_or_group
      branch:
        - group_begin
        - tuple_begin
    - match: \{
      scope: punctuation.section.block.begin.vala
      set:
        - match: \}
          scope: punctuation.section.block.end.vala
          pop: true
        - include: code_block_in
    - match: (?=[]}>,]|{{reserved}})
      pop: true

  group_begin:
    - meta_include_prototype: false
    - match: \(
      scope: punctuation.section.group.begin.vala
      set: group

  tuple_begin:
    - meta_include_prototype: false
    - match: \((?!\s*(?:owned|unowned|weak|void|dynamic)\s*\))
      scope: punctuation.section.sequence.begin.vala
      set: tuple

  tuple:
    - meta_scope: meta.sequence.tuple.vala
    - match: \)
      scope: punctuation.section.sequence.end.vala
      pop: true
    - match: ','
      scope: punctuation.separator.sequence.vala
    - match: ':'
      scope: keyword.operator.assignment.vala
    - match: _\b
      scope: variable.language.deconstruction.discard.vala
    - match: (?!{{reserved}})(?={{namespaced_name}}{{type_suffix}}\s+{{name}}\s*[:,])
      push: var_declaration_explicit
    - match: '({{name}})(<)'
      captures:
        1: support.type.vala
        2: meta.generic.vala punctuation.definition.generic.begin.vala
      push:
        - meta_content_scope: meta.generic.vala
        - match: ','
          scope: punctuation.separator.type.vala
        - match: (>)\s*(\()
          captures:
            1: meta.generic.vala punctuation.definition.generic.end.vala
            2: meta.function-call.vala meta.group.vala punctuation.section.group.begin.vala
          set: [function_call_arguments, arguments]
        - match: '>'
          scope: meta.generic.vala punctuation.definition.generic.end.vala
          pop: true
        - include: type
        - include: line_of_code_in_no_semicolon
    - include: line_of_code_in_no_semicolon

  group:
    - meta_scope: meta.group.vala
    - match: \)
      scope: punctuation.section.group.end.vala
      pop: true
    - match: ','
      fail: tuple_or_group
    - include: lambdas
    - include: line_of_code_in_no_semicolon

  attribute_arguments:
    - meta_content_scope: meta.annotation.vala meta.group.vala
    - match: \)
      scope: punctuation.section.group.end.vala
    - match: ''
      set: attribute_in

  constructor_arguments:
    - meta_content_scope: meta.instance.vala meta.group.vala
    - match: \)
      scope: punctuation.section.group.end.vala
      set: maybe_constructor_initializer
    - include: maybe_constructor_initializer

  maybe_constructor_initializer:
    - meta_content_scope: meta.instance.vala meta.group.vala
    - match: (?=[^\s{])
      pop: true
    - match: \{
      scope: punctuation.section.braces.begin.vala
      set: initializer_constructor

  function_call_arguments:
    - meta_content_scope: meta.function-call.vala meta.group.vala
    - match: \)
      scope: meta.function-call.vala meta.group.vala punctuation.section.group.end.vala
      pop: true
    - match: ''
      pop: true

  arguments:
    - match: (out)\s
      captures:
        1: storage.modifier.argument.vala
      push:
        - match: (ref)\s
          captures:
            1: storage.modifier.argument.vala
        - match: (?!{{namespaced_name}}{{type_suffix}}\s+{{name}})
          pop: true
        - include: var_declaration
    - match: (ref)\s
      captures:
        1: storage.modifier.argument.vala
    - match: '({{name}})\s*(=)(?=[^>=])'
      captures:
        1: variable.parameter.vala
        2: keyword.operator.assignment.vala
      push: line_of_code_in
    - match: '({{name}})\s*(:)'
      captures:
        1: variable.parameter.vala
        2: punctuation.separator.argument.value.vala
      push: line_of_code_in
    - match: ','
      scope: punctuation.separator.argument.vala
    - match: (?=\))
      pop: true
    - match: ;
      scope: invalid.illegal.expected-close-paren.vala
      pop: true
    - include: stray_close_bracket
    # @"""…""" must precede @"…", otherwise @" wins and the verbatim template
    # string is never recognised
    - match: '@"""'
      scope: punctuation.definition.string.begin.vala
      push: vala_verbatim_template_string
    - match: '@"'
      scope: punctuation.definition.string.begin.vala
      push: vala_template_string
    - match: (?=\S)
      push:
        - include: lambdas
        - include: line_of_code_in_no_semicolon
        - match: (?=[;)])
          pop: true

  accessor_arguments:
    - meta_content_scope: meta.brackets.vala
    - match: '({{name}})\s*(:)'
      captures:
        1: variable.other.parameter.vala
        2: punctuation.separator.key-value.parameter.vala
    - match: ','
      scope: punctuation.separator.accessor.vala
    - match: \]
      scope: meta.brackets.vala punctuation.section.brackets.end.vala
      pop: true
    - include: line_of_code_in

  qualified_constant_access:
    - match: '{{namespaced_constant_path_lookahead}}'
      push: namespaced_constant_path
    - match: '({{type_name}})(\s*\.\s*)((?!{{reserved}}\b){{constant_member}})(?!\s*\()'
      captures:
        1: support.type.vala
        2: punctuation.accessor.dot.namespace.vala
        3: constant.other.vala

  namespaced_constant_path:
    - match: '({{type_name}})(\s*\.\s*)(?={{type_name}}\s*\.)'
      captures:
        1: support.type.vala
        2: punctuation.accessor.dot.namespace.vala
    - match: '({{type_name}})(\s*\.\s*)((?!{{reserved}}\b){{constant_member}})(?!\s*\()'
      captures:
        1: support.type.vala
        2: punctuation.accessor.dot.namespace.vala
        3: constant.other.enum.vala
      pop: true
    # Vala.BinaryOperator.IN.to_string () — the member is followed by another
    # accessor, so the rule above (which needs the type prefix in the same
    # match) cannot fire; the preceding segments have already been consumed by
    # the first rule, which happily treats an all-caps member as a type name.
    - match: '((?!{{reserved}}\b){{constant_member}})(?=\s*[.?])'
      captures:
        1: constant.other.enum.vala
      pop: true
    # Safety net: never leave this context on the stack consuming the rest of
    # the file unscoped. Consumes a character so it cannot loop against the
    # zero-width lookahead that pushed us here.
    - match: '\S'
      pop: true

  # Namespace.Type.NameN in class/struct/interface declarations (e.g. class Test.Async)
  qualified_declaration_name_prefix:
    - match: '({{type_name}})(\s*\.\s*)(?={{type_name}}(?:{{generic_declaration}})?(?:\s*\.|\s*[:<{;]))'
      captures:
        1: support.type.vala
        2: punctuation.accessor.dot.namespace.vala

  # Parser.parse_*_declaration takes any identifier, so the name is not
  # necessarily PascalCase — glib-2.0.vapi declares `public struct int`,
  # `struct size_t`, … Without the lowercase fallback these contexts match
  # nothing and stay on the stack, swallowing the rest of the file.
  qualified_class_declaration_name:
    - include: qualified_declaration_name_prefix
    - match: '{{type_name}}'
      scope: entity.name.class.vala
      set: class_signature
    - match: '(?!{{reserved}}\b){{name}}'
      scope: entity.name.class.vala
      set: class_signature

  qualified_struct_declaration_name:
    - include: qualified_declaration_name_prefix
    - match: '{{type_name}}'
      scope: entity.name.struct.vala
      set: struct_signature
    - match: '(?!{{reserved}}\b){{name}}'
      scope: entity.name.struct.vala
      set: struct_signature

  qualified_interface_declaration_name:
    - include: qualified_declaration_name_prefix
    - match: '{{type_name}}'
      scope: entity.name.interface.vala
      set: interface_signature
    - match: '(?!{{reserved}}\b){{name}}'
      scope: entity.name.interface.vala
      set: interface_signature

  namespaced_type_path:
    - include: namespaced_type_path_common
    - match: '{{type_name}}'
      scope: support.type.vala
      pop: true

  namespaced_inherited_class_path:
    - include: namespaced_inherited_class_path_common
    - match: '{{type_name}}'
      scope: entity.other.inherited-class.vala
      pop: true

  namespaced_type_path_common:
    - match: '(?:(global)|({{name}}))(::)'
      captures:
        1: support.namespace.vala
        2: support.namespace.vala
        3: punctuation.accessor.double-colon.namespace.vala
    - match: '({{type_name}})(\s*\.\s*)(?={{type_name}}(?:{{generic_declaration}})?\s*\.)'
      captures:
        1: support.type.vala
        2: punctuation.accessor.dot.namespace.vala
    - match: '({{type_name}})({{generic_declaration}})'
      captures:
        1: support.type.vala
        2: meta.generic.vala
      pop: true

  namespaced_inherited_class_path_common:
    - match: '(?:(global)|({{name}}))(::)'
      captures:
        1: support.namespace.vala
        2: support.namespace.vala
        3: punctuation.accessor.double-colon.namespace.vala
    - match: '({{type_name}})(\s*\.\s*)(?={{type_name}}(?:{{generic_declaration}})?\s*\.)'
      captures:
        1: entity.other.inherited-class.vala
        2: punctuation.accessor.dot.namespace.vala
    - match: '({{type_name}})({{generic_declaration}})'
      captures:
        1: entity.other.inherited-class.vala
        2: meta.generic.vala
      pop: true

  type:
    - include: type_common
    - match: (?=\()
      push: type_tuple

  type_tuple:
    - match: \(
      scope: punctuation.section.sequence.begin.vala
      set:
        - meta_scope: meta.sequence.tuple.vala
        - match: \)
          scope: punctuation.section.sequence.end.vala
          pop: true
        - match: ','
          scope: punctuation.separator.sequence.vala
        - match: (?=\S)
          push: var_declaration_explicit

  type_common_except_bare_custom_type:
    - include: namespace_alias
    - match: '{{ownership}}'
      scope: storage.modifier.ownership.vala
    - match: \b(dynamic)\b
      scope: storage.modifier.vala
    - match: '(class|struct|enum)'
      scope: storage.type.other.vala
    - match: 'new\s*\(\s*\)'
      scope: keyword.operator.new.vala
    - match: '{{base_type}}'
      scope: storage.type.vala
    - match: '{{array_length_capture}}'
      captures:
        1: meta.brackets.vala
        2: punctuation.section.brackets.begin.vala
        3: constant.numeric.value.vala
        4: punctuation.separator.vala
        5: storage.type.vala
        6: punctuation.section.brackets.end.vala
    - match: '{{brackets_capture}}'
      captures:
        1: meta.brackets.vala
        2: punctuation.section.brackets.begin.vala
        3: punctuation.separator.vala
        4: punctuation.section.brackets.end.vala
    - match: \s*(\.)\s*
      captures:
        1: punctuation.accessor.dot.namespace.vala
    - match: '\*'
      scope: keyword.operator.pointer.vala
    # `??` is never part of a type: it is the null-coalescing operator, as in
    # `x as T ?? fallback` (issue #15). Without the `(?!\?)` both characters
    # were read as nullable markers.
    - match: \s*(\?)(?!\?)
      captures:
        1: storage.type.nullable.vala
    - match: \s*(<)
      captures:
        1: meta.generic.vala punctuation.definition.generic.begin.vala
      push: inside_type_argument
    - match: '({{errordomain_type_name}})(\s*\.\s*)((?!{{reserved}}\b){{name}})'
      captures:
        1: support.type.vala
        2: punctuation.accessor.dot.namespace.vala
        3: constant.other.errordomain.vala
    - match: (?=[]})>,;>:]|=>|\?\?)
      pop: true

  type_common:
    - include: type_common_except_bare_custom_type
    - match: '{{name}}'
      scope: support.type.vala

  type_arg_param_common:
    - match: '(>){{type_suffix_capture}}'
      captures:
        1: meta.generic.vala punctuation.definition.generic.end.vala
        2: storage.type.nullable.vala
        3: meta.brackets.vala
        4: punctuation.section.brackets.begin.vala
        5: punctuation.separator.vala
        6: punctuation.section.brackets.end.vala
        7: keyword.operator.pointer.vala
      pop: true
    - match: ','
      scope: punctuation.separator.type.vala

  type_arguments:
    - match: '<'
      scope: meta.generic.vala punctuation.definition.generic.begin.vala
      push: inside_type_argument

  inside_type_argument:
    - meta_content_scope: meta.generic.vala
    - include: type_arg_param_common
    - include: type

  maybe_type_parameters:
    - match: '<'
      scope: meta.generic.vala punctuation.definition.generic.begin.vala
      push: inside_type_parameter

  inside_type_parameter:
    - meta_content_scope: meta.generic.vala
    - include: type_arg_param_common
    - include: type_common_except_bare_custom_type
    - match: '(in|out)\b'
      scope: storage.modifier.vala
    - match: '{{name}}'
      scope: variable.parameter.type.vala

  type_no_space:
    - include: type
    - match: \s
      pop: true

  # bools, numbers, chars, simple strings
  literals:
    # language constants
    - match: \b(true|false|null)\b
      scope: constant.language.vala
    # characters
    - match: (')({{escaped_char}})(')
      scope: meta.string.vala
             string.quoted.single.vala
      captures:
        1: punctuation.definition.string.begin.vala
        2: constant.character.escape.vala
        3: punctuation.definition.string.end.vala
    - match: (')([^'\\])(')
      scope: meta.string.vala
             string.quoted.single.vala
      captures:
        1: punctuation.definition.string.begin.vala
        2: constant.character.literal.vala
        3: punctuation.definition.string.end.vala
    # a backslash that did not start one of the escapes above
    - match: '''\\.?'''
      scope: invalid.illegal.lone-escape.vala
    - match: ''''''
      scope: invalid.illegal.not_a_char.vala
    - match: (')[^']+(')
      scope: invalid.illegal.not_a_char.vala
    # numbers (see tests/vala/syntax/literals/syntax_test_numbers.vala)
    # hex float: 0x1.fP1, 0x0.8P1, 0xab.cdp20, 0x47.11p9 (requires p/P exponent)
    - match: '(0[xX])([\h]+)(?:(\.)([\h]+))?((?i)[pP][-+]?\d+)({{float_suffix}})?'
      scope: constant.numeric.float.hexadecimal.vala
      captures:
        1: constant.numeric.base.vala
        2: constant.numeric.value.vala
        3: punctuation.separator.decimal.vala
        4: constant.numeric.value.vala
        5: constant.numeric.value.exponent.vala
        6: constant.numeric.suffix.vala
    - match: '(0[xX])([\h]+)({{integer_suffix}})?'
      scope: constant.numeric.integer.hexadecimal.vala
      captures:
        1: constant.numeric.base.vala
        2: constant.numeric.value.vala
        3: constant.numeric.suffix.vala
    - match: '(0[bB])([01]+)({{integer_suffix}})?'
      scope: constant.numeric.integer.binary.vala
      captures:
        1: constant.numeric.base.vala
        2: constant.numeric.value.vala
        3: constant.numeric.suffix.vala
    - match: '(0[oO])([0-7]+)({{integer_suffix}})?'
      scope: constant.numeric.integer.octal.vala
      captures:
        1: constant.numeric.base.vala
        2: constant.numeric.value.vala
        3: constant.numeric.suffix.vala
    - match: '(0)([0-7]+)({{integer_suffix}})?'
      scope: constant.numeric.integer.octal.vala
      captures:
        1: constant.numeric.base.vala
        2: constant.numeric.value.vala
        3: constant.numeric.suffix.vala
    # decimal float: digits required after '.'; 1.e10 is invalid (Vala scanner)
    - match: '(\d+\.(?![0-9]){{dec_exponent}})'
      scope: invalid.illegal.numeric-float-decimal.vala
    - match: '(\d+)(\.)(\d+)({{dec_exponent}})?({{float_suffix}})?'
      scope: constant.numeric.float.decimal.vala
      captures:
        1: constant.numeric.value.vala
        2: punctuation.separator.decimal.vala
        3: constant.numeric.value.vala
        4: constant.numeric.value.exponent.vala
        5: constant.numeric.suffix.vala
    - match: '(\d+)({{dec_exponent}})({{float_suffix}})?'
      scope: constant.numeric.float.decimal.vala
      captures:
        1: constant.numeric.value.vala
        2: constant.numeric.value.exponent.vala
        3: constant.numeric.suffix.vala
    # digits + f/F/d/D is a real literal (read_number); the lookahead keeps
    # identifiers that start with a digit (1foo) out of this rule
    - match: '(\d+)({{float_suffix}})(?![[:alnum:]_])'
      scope: constant.numeric.float.decimal.vala
      captures:
        1: constant.numeric.value.vala
        2: constant.numeric.suffix.vala
    - match: '(0|[1-9]\d*)({{integer_suffix}})?'
      scope: constant.numeric.integer.decimal.vala
      captures:
        1: constant.numeric.value.vala
        2: constant.numeric.suffix.vala
    # Verbatim template strings (@"""...""") with $ interpolation — must precede
    # @"…", otherwise @" wins and this rule is unreachable
    - match: '@"""'
      scope: punctuation.definition.string.begin.vala
      push: vala_verbatim_template_string
    # Vala template strings (@"...") — must precede plain "
    - match: '@"'
      scope: punctuation.definition.string.begin.vala
      push: vala_template_string
    # verbatim strings (""")
    - match: '"""'
      scope: punctuation.definition.string.begin.vala
      push: vala_verbatim_string
    # strings
    - match: '"'
      scope: punctuation.definition.string.begin.vala
      push: string

  string:
    - meta_include_prototype: false
    - meta_scope: string.quoted.double.vala
    - include: string_escaped
    - match: '"'
      scope: punctuation.definition.string.end.vala
      pop: true
    - match: $\n?
      scope: invalid.illegal.unclosed-string.vala
      pop: true

  vala_verbatim_string:
    - meta_include_prototype: false
    - meta_scope: string.quoted.double.raw.vala
    - match: '"""'
      scope: punctuation.definition.string.end.vala
      pop: true

  vala_verbatim_template_string:
    - meta_include_prototype: false
    - meta_scope: meta.string.vala string.quoted.double.raw.vala
    - match: '"""'
      scope: punctuation.definition.string.end.vala
      pop: true
    - match: '\$\$'
      scope: constant.character.escape.vala
    - match: '\$\('
      scope: punctuation.section.interpolation.begin.vala
      push:
        - meta_scope: meta.interpolation.vala
        - meta_content_scope: source.vala.embedded
        - clear_scopes: 2
        - match: '\)'
          scope: punctuation.section.interpolation.end.vala
          pop: true
        - include: line_of_code_in
    - match: '\$'
      scope: punctuation.definition.template-expression.begin.vala
      push:
        - meta_scope: meta.template-expression.vala
        - clear_scopes: 2
        - match: '[[:alpha:]_][[:alnum:]_]*'
          scope: variable.other.vala
          pop: true
        - match: ''
          scope: invalid.illegal.vala
          pop: true
    - match: '[^"$]+'

  vala_template_string:
    - meta_include_prototype: false
    - meta_scope: meta.string.vala string.quoted.double.vala
    - match: '"'
      scope: punctuation.definition.string.end.vala
      pop: true
    # $$ — literal dollar (valascanner: TEMPLATE_STRING_LITERAL)
    - match: '\$\$'
      scope: constant.character.escape.vala
    # $(expression) — embedded Vala expression
    - match: '\$\('
      scope: punctuation.section.interpolation.begin.vala
      push:
        - meta_scope: meta.interpolation.vala
        - meta_content_scope: source.vala.embedded
        - clear_scopes: 2
        - match: '\)'
          scope: punctuation.section.interpolation.end.vala
          pop: true
        - include: line_of_code_in
    # $identifier — must start with letter or _ (valascanner.is_ident_char)
    - match: '\$'
      scope: punctuation.definition.template-expression.begin.vala
      push:
        - meta_scope: meta.template-expression.vala
        - clear_scopes: 2
        - match: '[[:alpha:]_][[:alnum:]_]*'
          scope: variable.other.vala
          pop: true
        - match: ''
          scope: invalid.illegal.vala
          pop: true
    - include: string_escaped
    - match: $\n?
      scope: invalid.illegal.unclosed-string.vala
      pop: true

  regex_literal:
    - meta_include_prototype: false
    - meta_scope: string.regexp.vala
    - match: '(/)([imsxo]*)'
      scope: punctuation.definition.regex.end.vala
      captures:
        2: keyword.other.vala
      pop: true
    - match: '\\.'
      scope: constant.character.escape.vala
    - match: '[^/\n]+'

  format_string:
    - meta_include_prototype: false
    - meta_scope: meta.string.vala string.quoted.double.vala
    - match: '"'
      scope: punctuation.definition.string.end.vala
      pop: true
    - include: string_escaped
    - include: string_placeholder_escape
    - match: \{
      scope: punctuation.section.interpolation.begin.vala
      push:
        - meta_scope: meta.string.vala
        - meta_content_scope: source.vala
        - clear_scopes: 2
        - match: $
          pop: true
        - include: string_placeholder_format
        - include: string_interpolation
    - match: $\n?
      scope: invalid.illegal.unclosed-string.vala
      pop: true

  long_format_string:
    - meta_include_prototype: false
    - meta_scope: meta.string.vala string.quoted.double.raw.vala
    - include: long_string_escaped
    - match: '"'
      scope: punctuation.definition.string.end.vala
      pop: true
    - include: string_placeholder_escape
    - match: \{
      scope: punctuation.section.interpolation.begin.vala
      push:
        - meta_scope: meta.string.vala
        - meta_content_scope: source.vala
        - clear_scopes: 2
        - include: long_string_placeholder_format
        - include: string_interpolation

  string_placeholder_escape:
    - match: '\{\{|\}\}'
      scope: constant.character.escape.vala

  string_placeholders:
    - include: string_placeholder_escape
    - match: \{\h{8}-(?:\h{4}-){3}\h{12}\}
      scope: constant.other.guid.vala
    - match: '(\{)(\d+)(?=")'
      scope: constant.other.placeholder.vala
      captures:
        1: punctuation.definition.placeholder.begin.vala
        2: constant.numeric.integer.decimal.vala constant.numeric.value.vala invalid.illegal.unclosed-string-placeholder.vala

  inside_string_placeholder:
    - match: '(\})(\}(?!\}))?'
      captures:
        1: punctuation.definition.placeholder.end.vala
        2: invalid.illegal.unescaped-placeholder.vala
      pop: true
    - match: (?=[}"])
      pop: true

  string_placeholder:
    - meta_scope: constant.other.placeholder.vala
    - include: inside_string_placeholder
    - include: string_placeholder_format
    - match: '[^"}]+'
      scope: invalid.illegal.unexpected-character-in-placeholder.vala

  long_string_placeholder:
    - meta_scope: constant.other.placeholder.vala
    - include: inside_string_placeholder
    - include: long_string_placeholder_format
    - match: '[^"}]+'
      scope: invalid.illegal.unexpected-character-in-placeholder.vala

  string_placeholder_format:
    - match: '\s*(?:(,)\s*((-?)\d+)\s*)?'
      captures:
        1: punctuation.separator.arguments.vala
        2: constant.numeric.integer.decimal.vala constant.numeric.value.vala
        3: keyword.operator.arithmetic.vala
    - match: ':(?=")'
      scope: invalid.illegal.unclosed-string-placeholder.vala
      pop: true
    - match: ':'
      scope: punctuation.separator.vala
      push:
        - meta_scope: constant.other.format-spec.vala
        - include: string_placeholder_escape
        - include: string_escaped
        - match: '(?=\})'
          pop: true
        - match: '([^}"\\]+(\\.)*)+(?=")'
          scope: invalid.illegal.unclosed-string-placeholder.vala
          pop: true
        - match: '\{'
          scope: invalid.illegal.unescaped-placeholder.vala

  long_string_placeholder_format:
    - match: '\s*(?:(,)\s*((-?)\d+)\s*)?'
      captures:
        1: punctuation.separator.arguments.vala
        2: constant.numeric.integer.decimal.vala constant.numeric.value.vala
        3: keyword.operator.arithmetic.vala
    - match: ':(?="(?!"))'
      scope: invalid.illegal.unclosed-string-placeholder.vala
      pop: true
    - match: ':'
      scope: punctuation.separator.vala
      push:
        - meta_scope: constant.other.format-spec.vala
        - include: string_placeholder_escape
        - include: long_string_escaped
        - match: (?=\})
          pop: true
        - match: \\(?:""|[^"])
          scope: constant.character.escape.vala
        - match: (?:[^}"]+|"")+(?="(?!"))
          scope: invalid.illegal.unclosed-string-placeholder.vala
          pop: true
        - match: \{
          scope: invalid.illegal.unescaped-placeholder.vala

  string_interpolation:
    - match: '\}'
      scope: punctuation.section.interpolation.end.vala
      pop: true
    - include: line_of_code_in

  long_string:
    - meta_include_prototype: false
    - meta_scope: string.quoted.double.raw.vala
    - include: long_string_escaped
    - include: string_placeholders
    - match: '(\{)(\d+)'
      captures:
        1: punctuation.definition.placeholder.begin.vala
        2: constant.numeric.integer.decimal.vala constant.numeric.value.vala
      push: long_string_placeholder
    - match: '"'
      scope: punctuation.definition.string.end.vala
      pop: true

  escaped:
    - match: '{{escaped_char}}'
      scope: constant.character.escape.vala

  string_escaped:
    - include: escaped
    - match: \\
      scope: invalid.illegal.lone-escape.vala

  long_string_escaped:
    - match: '""'
      scope: constant.character.escape.vala

  initializer_constructor:
    - meta_content_scope: meta.instance.vala meta.braces.vala
    - match: \}
      scope: meta.instance.vala meta.braces.vala punctuation.section.braces.end.vala
      pop: true
    - match: \{
      scope: punctuation.section.braces.begin.vala
      push: initializer_constructor
    - match: ','
      scope: punctuation.separator.array-element.vala
    - match: (?=[^,\s{}])
      push: line_of_code_in

  try_block:
    - match: \{
      scope: punctuation.section.block.begin.vala
      set:
        - meta_scope: meta.block.vala
        - match: \}
          scope: punctuation.section.block.end.vala
          pop: true
        - include: main
    - match: (?=\S)
      set:
        - match: \s*$
          pop: true
        - include: main

  catch_expr:
    - match: '(catch)\s*(\()'
      captures:
        1: keyword.control.catch.vala
        2: meta.group.vala punctuation.section.group.begin.vala
      push: [catch_block, var_declaration_explicit]
    - match: 'catch'
      scope: keyword.control.catch.vala
      push: trycatch_block
    - match: (?=\S)
      pop: true

  catch_block:
    - meta_content_scope: meta.group.vala
    - match: \)
      scope: meta.group.vala punctuation.section.group.end.vala
      set: catch_when

  catch_when:
    - match: \bwhen\b
      scope: keyword.control.when.vala
      set:
        - match: \(
          scope: punctuation.section.group.begin.vala
          set:
            - meta_scope: meta.group.vala
            - match: \)
              scope: punctuation.section.group.end.vala
              set: trycatch_block
            - include: line_of_code_in
        - match: (?=\S)
          set: trycatch_block
    - match: '(?=\S)'
      set: trycatch_block

  finally_block:
    - meta_scope: meta.block.vala
    - match: finally\b
      scope: keyword.control.finally.vala
      set: trycatch_block
    - match: (?=\S)
      pop: true

  trycatch_block:
    - match: \{
      scope: punctuation.section.block.begin.vala
      set:
        - meta_scope: meta.block.vala
        - match: \}
          scope: punctuation.section.block.end.vala
          pop: true
        - include: code_block_in
    - match: (?=\S)
      pop: true

  using_block:
    - meta_content_scope: meta.group.vala
    - match: \)
      scope: meta.group.vala punctuation.section.group.end.vala
      set:
      - match: \{
        scope: punctuation.section.block.begin.vala
        set:
          - meta_scope: meta.block.vala
          - match: \}
            scope: punctuation.section.block.end.vala
            pop: true
          - include: code_block_in
      - match: (?=\S)
        pop: true
    - match: (?=\S)
      pop: true

  expression_block:
    - meta_content_scope: meta.group.vala
    - match: \)
      scope: meta.group.vala punctuation.section.group.end.vala
      set:
        - match: \{
          scope: meta.block.vala punctuation.section.block.begin.vala
          set:
            - meta_content_scope: meta.block.vala
            - match: \}
              scope: meta.block.vala punctuation.section.block.end.vala
              pop: true
            - include: code_block_in
        - match: (?=\S)
          set: line_of_code

  if_condition:
    - match: '\s*(\()'
      captures:
        1: meta.group.vala punctuation.section.group.begin.vala
      set:
        - meta_content_scope: meta.group.vala
        - match: '\s*(\))'
          captures:
            1: meta.group.vala punctuation.section.group.end.vala
          pop: true
        - include: line_of_code_in
    - match: (?=[^(])
      pop: true

  if_block:
    - match: \{
      scope: meta.block.vala punctuation.section.block.begin.vala
      set:
        - meta_content_scope: meta.block.vala
        - match: \}
          scope: meta.block.vala punctuation.section.block.end.vala
          pop: true
        - include: main
    - match: (?=\S)
      set:
        - match: (?=else\b)
          pop: true
        - include: line_of_code

  else_block:
    - match: (else\s+if)\b\s*
      captures:
        1: keyword.control.conditional.elseif.vala
      push: [if_block, if_condition]
    - match: (else)\s*
      scope: keyword.control.conditional.else.vala
      set:
        - match: \s*(\{)
          captures:
            1: meta.block.vala punctuation.section.block.begin.vala
          set:
            - meta_content_scope: meta.block.vala
            - match: \}
              scope: meta.block.vala punctuation.section.block.end.vala
              pop: true
            - include: main
        - match: (?=\S)
          set:
            - include: line_of_code
    - match: (?=\S)
      pop: true

  switch_condition:
    - match: '\('
      scope: punctuation.section.group.begin.vala
      set:
        - meta_scope: meta.group.vala
        - match: '\)'
          scope: punctuation.section.group.end.vala
          pop: true
        - include: line_of_code_in
    - match: (?=\S)
      pop: true

  switch_block:
    - match: \{
      scope: punctuation.section.block.begin.vala
      set:
        - meta_scope: meta.block.vala
        - match: \}
          scope: punctuation.section.block.end.vala
          pop: true
        - match: '\b(default)\s*(:)'
          captures:
            1: keyword.control.switch.case.vala
            2: punctuation.separator.case-statement.vala
        - match: '\b(case)\b'
          scope: keyword.control.switch.case.vala
          push:
            - match: '{{name}}(?=\s*:)'
              scope: constant.other.vala
            - match: '\bwhen\b'
              scope: keyword.control.switch.case.when.vala
            - match: '(?={{namespaced_name}}{{type_suffix}}\s+{{name}}\s+when\b)'
              push: var_declaration_explicit
            - match: ':'
              scope: punctuation.separator.case-statement.vala
              pop: true
            - include: line_of_code_in
            - match: $
              pop: true
        - include: code_block_in
    - match: '(?=\S)'
      pop: true

  switch_expression:
    # never linger if the brace never arrives
    - match: '(?=[^\s{])'
      pop: true
    - match: \{
      scope: punctuation.section.block.begin.vala
      set:
        - meta_scope: meta.block.vala
        - match: \}
          scope: punctuation.section.block.end.vala
          pop: true
        - match: '=>'
          scope: punctuation.separator.case-expression.vala
          push:
            - match: ','
              scope: punctuation.terminator.case-expression.vala
              pop: true
            - include: line_of_code_in
        - match: \b_\b
          scope: variable.language.deconstruction.discard.vala
        - match: '\bwhen\b'
          scope: keyword.control.switch.case.when.vala
        - match: \(
          scope: punctuation.section.sequence.begin.vala
          push:
            - meta_scope: meta.sequence.tuple.vala
            - match: \)
              scope: punctuation.section.sequence.end.vala
              pop: true
            - match: ','
              scope: punctuation.separator.sequence.vala
            - match: _\b
              scope: variable.language.deconstruction.discard.vala
            - include: line_of_code_in_no_semicolon # needed for "when" syntax?
        - match: (?={{namespaced_name}}\s+(?:\{|(?!{{reserved}}|when\b){{name}}))
          push: [maybe_pattern_matching_object, var_declaration]
        - match: (?=\bvar\b)
          push: var_declaration_including_tuple
        - match: (?=\{)
          push: maybe_pattern_matching_object
        - include: line_of_code_in_no_semicolon

  maybe_pattern_matching_object:
    - match: \{
      scope: meta.instance.property-subpattern.vala meta.class.body.anonymous.vala meta.block.vala punctuation.section.block.begin.vala
      set: pattern_matching_object
    - match: (?=\S)
      pop: true

  pattern_matching_object:
    - meta_content_scope: meta.instance.property-subpattern.vala meta.class.body.anonymous.vala meta.block.vala
    - match: \}
      scope: meta.instance.property-subpattern.vala meta.class.body.anonymous.vala meta.block.vala punctuation.section.block.end.vala
      pop: true
    - match: ','
      scope: punctuation.separator.property.vala
    - match: '({{name}})\s*(:)?'
      captures:
        1: variable.other.member.vala
        2: keyword.operator.assignment.vala
      push: line_of_code_in_no_semicolon

  for_var_assignment:
    - match: '='
      scope: keyword.operator.assignment.variable.loop.vala
      set: line_of_code_in
    - match: (?=;|\)|\})
      pop: true

  foreach_var_assignment:
    - match: '\b(in)\b'
      scope: keyword.control.vala
      set: line_of_code_in
    - match: (?=\)|\})
      pop: true

  var_declaration:
    - match: (var)\s*(\()
      captures:
        1: storage.type.variable.vala
        2: meta.sequence.tuple.vala punctuation.section.sequence.begin.vala
      set:
        - meta_content_scope: meta.sequence.tuple.vala
        - match: \)
          scope: meta.sequence.tuple.vala punctuation.section.sequence.end.vala
          pop: true
        - match: _\b
          scope: variable.language.deconstruction.discard.vala
        - match: '{{name}}'
          scope: variable.other.vala
        - match: ','
          scope: punctuation.separator.sequence.vala
    - match: '(var)\s+({{name}})\s*(?!=>)'
      captures:
        1: storage.type.variable.vala
        2: variable.other.vala
      pop: true
    - include: var_declaration_explicit

  foreach_header:
    - include: foreach_index_value_form
    - match: '({{ownership}})\s+({{base_type}}){{type_suffix_capture}}\s+({{name}})(?=\s*\bin\b)'
      captures:
        1: storage.modifier.ownership.vala
        2: storage.type.vala
        3: storage.type.nullable.vala
        4: meta.brackets.vala
        5: punctuation.section.brackets.begin.vala
        6: punctuation.separator.vala
        7: punctuation.section.brackets.end.vala
        8: keyword.operator.pointer.vala
        9: variable.other.vala
      pop: true
    - match: '({{base_type}}){{type_suffix_capture}}\s+({{name}})(?=\s*\bin\b)'
      captures:
        1: storage.type.vala
        2: storage.type.nullable.vala
        3: meta.brackets.vala
        4: punctuation.section.brackets.begin.vala
        5: punctuation.separator.vala
        6: punctuation.section.brackets.end.vala
        7: keyword.operator.pointer.vala
        8: variable.other.vala
      pop: true
    - match: '({{type_name}})\s+({{name}})(?=\s*\bin\b)'
      captures:
        1: support.type.vala
        2: variable.other.vala
      pop: true
    - match: '(var)\s+({{name}})(?=\s*\bin\b)'
      captures:
        1: storage.type.variable.vala
        2: variable.other.vala
      pop: true
    - include: var_declaration_including_tuple
    - match: (?=\s*\bin\b)
      pop: true

  foreach_index_value_form:
    - match: '(var)\s+({{name}})\s*(=>)\s*'
      captures:
        1: storage.type.variable.vala
        2: variable.other.vala
        3: keyword.operator.vala
      push: foreach_index_value_tail
    - match: '({{base_type}}){{type_suffix_capture}}\s+({{name}})\s*(=>)\s*'
      captures:
        1: storage.type.vala
        2: storage.type.nullable.vala
        3: meta.brackets.vala
        4: punctuation.section.brackets.begin.vala
        5: punctuation.separator.vala
        6: punctuation.section.brackets.end.vala
        7: keyword.operator.pointer.vala
        8: variable.other.vala
        9: keyword.operator.vala
      push: foreach_index_value_tail

  foreach_index_value_tail:
    - match: '{{ownership}}\s+'
      scope: storage.modifier.ownership.vala
    - match: '({{base_type}})\s+({{name}})(?=\s*\bin\b)'
      captures:
        1: storage.type.vala
        2: variable.other.vala
      pop: true
    - match: '({{type_name}})\s+({{name}})(?=\s*\bin\b)'
      captures:
        1: support.type.vala
        2: variable.other.vala
      pop: true
    - include: type_no_space
    - match: '{{name}}\s*'
      scope: variable.other.vala
      pop: true

  var_declaration_including_tuple:
    - include: var_declaration
    - include: type_tuple

  var_declaration_explicit:
    - match: '({{name}})\s*(\.)'
      captures:
        1: support.type.vala
        2: punctuation.accessor.dot.namespace.vala
    - match: '({{name}})\s*(<)'
      captures:
        1: support.type.vala
        2: meta.generic.vala punctuation.definition.generic.begin.vala
      set:
        - meta_content_scope: meta.generic.vala
        - match: '>'
          scope: meta.generic.vala punctuation.definition.generic.end.vala
          set:
            - match: '({{name}})\s*'
              captures:
                1: variable.other.vala
              pop: true
            - match: (?=[,);}])
              pop: true
        - include: inside_type_argument
    - match: '({{base_type}}){{type_suffix_capture}}'
      captures:
        1: storage.type.vala
        2: storage.type.nullable.vala
        3: meta.brackets.vala
        4: punctuation.section.brackets.begin.vala
        5: punctuation.separator.vala
        6: punctuation.section.brackets.end.vala
        7: keyword.operator.pointer.vala
      set:
        - match: '({{name}})\s*'
          captures:
            1: variable.other.vala
        - match: '(\[)'
          scope: meta.brackets.vala punctuation.section.brackets.begin.vala
          push: inline_fixed_array_length
        - match: '(?=\s*\bin\b)'
          pop: true
        # Hand the initializer back to the caller (for_var_assignment, ...).
        # Without the `=` this context sat on `for (unichar c = next_char (); …)`
        # and scoped `next_char` as a variable, leaving its `(` unopened - the
        # matching `)` then closed the for header and the real one was a stray.
        - match: '(?=[,);}=;])'
          pop: true
    - match: '(?!(?:{{ownership}}\s+){{base_type}}\b)(?:({{name}}){{type_suffix_capture}})(?:\s+((?!{{reserved}}\b){{name}}))?\s*'
      captures:
        1: support.type.vala
        2: storage.type.nullable.vala
        3: meta.brackets.vala
        4: punctuation.section.brackets.begin.vala
        5: punctuation.separator.vala
        6: punctuation.section.brackets.end.vala
        7: keyword.operator.pointer.vala
        8: variable.other.vala
      pop: true
    - match: (?=\))
      pop: true

  using_var_assignment:
    - match: '='
      scope: keyword.operator.assignment.variable.using.vala
      push: line_of_code_in
    - match: (?=;|\)|\})
      pop: true
    - match: ','
      scope: punctuation.separator.expression.vala
      push: line_of_code_in

  for_block:
    - meta_content_scope: meta.group.vala
    - match: \)
      scope: punctuation.section.group.end.vala
      set:
      - match: \{
        scope: punctuation.section.block.begin.vala
        set:
          - meta_scope: meta.block.vala
          - match: \}
            scope: punctuation.section.block.end.vala
            pop: true
          - include: code_block_in
      - match: (?=\S)
        set:
          - include: line_of_code
    # The iterator clause was left unparsed: for_block only waited for the
    # closing paren, so anything with parens of its own in it
    # (`for (…; …; i = f (x))`) ended the header early and the real closing
    # paren was flagged as a stray brace. Parse it in a frame of its own -
    # line_of_code_in_no_semicolon pops on a bare comma, and the clause is a
    # comma-separated statement list.
    - match: '(?=\S)'
      push:
        - match: ','
          scope: punctuation.separator.sequence.vala
        - match: '(?=\))'
          pop: true
        - include: line_of_code_in_no_semicolon

  while_block:
    - match: \{
      scope: punctuation.section.block.begin.vala
      set:
        - meta_scope: meta.block.vala
        - match: '\}'
          scope: punctuation.section.block.end.vala
          pop: true
        - include: code_block_in
    - match: (?=\S)
      set:
        - include: line_of_code

  do_condition:
    - match: \b(while)\b
      scope: keyword.control.while.vala
      set: while_condition
    - match: (?=\S)
      pop: true

  while_condition:
    - match: \(
      scope: punctuation.section.group.begin.vala
      set:
        - meta_scope: meta.group.vala
        - match: '\)'
          scope: punctuation.section.group.end.vala
          pop: true
        - include: line_of_code_in
    - match: (?=\S)
      pop: true

  construct_block_declaration:
    - match: '\b(static)\s+(construct)\b'
      captures:
        1: storage.modifier.vala
        2: keyword.context.block.vala
      push: construct_block_body
    - match: '\b(class)\s+(construct)\b'
      captures:
        1: storage.type.class keyword.declaration.class.vala
        2: keyword.context.block.vala
      push: construct_block_body
    - match: '\b(construct)\b'
      scope: keyword.context.block.vala
      push: construct_block_body

  construct_block_body:
    - match: '\{'
      scope: punctuation.section.block.begin.vala
      set:
        - meta_scope: meta.block.vala
        - match: '\}'
          scope: punctuation.section.block.end.vala
          pop: true
        - include: code_block_in
    - match: '(?=\S)'
      pop: true